              "t": "digestion",
              "term": "digestion",
              "cat": "physiology"
            },
            {
              "t": ", is the final phase occurring in the "
            },
            {
              "t": "Pakvashaya",
              "term": "pakvashaya",
              "cat": "ayurveda"
            },
            {
              "t": " ("
            },
            {
              "t": "large intestine",
              "term": "large intestine",
              "cat": "anatomy"
            },
            {
              "t": "). "
            },
            {
              "t": "The Bhūtas",
              "term": "the bhutas",
              "cat": "ayurveda"
            },
            {
              "t": " (elements) of "
            },
            {
              "t": "Kashāya",
              "term": "kashaya",
              "cat": "ayurveda"
            },
            {
              "t": " are "
            },
            {
              "t": "Vāyu",
              "term": "vayu",
              "cat": "ayurveda"
            },
            {
              "t": " (air) and "
            },
            {
              "t": "Prthivī",
              "term": "prthivi",
              "cat": "ayurveda"
            },
            {
              "t": " (earth). This process begins when "
            },
            {
              "t": "Apāna Vāyu",
              "term": "apana vayu",
              "cat": "ayurveda"
            },
            {
              "t": " and "
