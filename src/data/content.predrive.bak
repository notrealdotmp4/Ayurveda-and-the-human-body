            },
            {
              "t": "hypothalamus",
              "term": "hypothalamus",
              "cat": "anatomy"
            },
            {
              "t": ", where "
            },
            {
              "t": "Sādhaka Pitta",
              "term": "sadhaka pitta",
              "cat": "ayurveda"
            },
            {
              "t": ", located in the "
            },
            {
              "t": "brain's grey matter",
              "term": "brains grey matter",
              "cat": "anatomy"
            },
            {
              "t": " for comprehension and emotions, processes this perception. "
            },
            {
              "t": "Prāna Vāyu",
              "term": "prana vayu",
              "cat": "ayurveda"
            },
            {
              "t": ", moving in a downward and inward direction, initiates "
            },
            {
              "t": "mastication",
              "term": "mastication",
              "cat": "physiology"
            },
            {
              "t": " and propels the "
            },
            {
              "t": "bolus",
              "term": "bolus",
              "cat": "physiology"
            },
            {
              "t": " through the "
            },
            {
              "t": "pharynx",
              "term": "pharynx",
              "cat": "anatomy"
            },
            {
              "t": " and "
            },
            {
              "t": "esophagus",
              "term": "esophagus",
              "cat": "anatomy"
            },
            {
              "t": " via "
            },
            {
              "t": "peristalsis",
              "term": "peristalsis",
              "cat": "physiology"
            },
            {
              "t": " into the "
            },
            {
              "t": "fundus",
              "term": "fundus",
              "cat": "anatomy"
            },
            {
              "t": ". There, "
            },
            {
              "t": "Kledaka Kapha",
              "term": "kledaka kapha",
              "cat": "ayurveda"
            },
            {
              "t": " produces protective "
            },
            {
              "t": "mucus",
              "term": "mucus",
              "cat": "physiology"
            },
            {
              "t": " to shield the "
            },
            {
              "t": "stomach",
              "term": "stomach",
              "cat": "anatomy"
            },
            {
              "t": " wall from digestive "
            },
            {
              "t": "acids",
              "term": "acids",
              "cat": "physiology"
            },
            {
              "t": " while "
            },
            {
              "t": "Samāna Vāyu",
              "term": "samana vayu",
              "cat": "ayurveda"
            },
            {
              "t": " initiates the churning process. "
            },
            {
              "t": "Madhura",
              "term": "madhura",
              "cat": "ayurveda"
            },
            {
              "t": ", yielded into "
            },
            {
              "t": "Rasa Dhātu",
              "term": "rasa dhatu",
              "cat": "ayurveda"
            },
            {
              "t": ", is located on the tip of the "
            },
            {
              "t": "tongue",
              "term": "tongue",
              "cat": "anatomy"
            },
            {
              "t": ",  "
            },
            {
              "t": "Jihvā",
              "term": "jihva",
              "cat": "ayurveda"
            },
            {
              "t": ", and is energetically linked to the "
            },
            {
              "t": "thyroid",
