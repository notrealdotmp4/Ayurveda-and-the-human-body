            {
              "t": "Samāna Vāyu",
              "term": "samana vayu",
              "cat": "ayurveda"
            },
            {
              "t": " open the "
            },
            {
              "t": "ileocecal valve",
              "term": "ileocecal valve",
              "cat": "anatomy"
            },
            {
              "t": ", allowing "
            },
            {
              "t": "chyme",
              "term": "chyme",
              "cat": "physiology"
            },
            {
              "t": " to enter the "
            },
            {
              "t": "cecum",
              "term": "cecum",
              "cat": "anatomy"
            },
            {
              "t": ". Within the "
