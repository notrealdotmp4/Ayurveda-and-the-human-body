            },
            {
              "t": ", and "
            },
            {
              "t": "diaphragm",
              "term": "diaphragm",
              "cat": "anatomy"
            },
            {
              "t": ". The "
            },
            {
              "t": "Vipāka",
              "term": "vipaka",
              "cat": "ayurveda"
            },
            {
              "t": " (post-digestive effect) of "
            },
            {
              "t": "Katu",
              "term": "katu",
