            },
            {
              "t": "Jihvā",
              "term": "jihva",
              "cat": "ayurveda"
            },
            {
              "t": " ("
            },
            {
              "t": "tongue",
              "term": "tongue",
              "cat": "anatomy"
            },
            {
              "t": "), positioned behind the pungent area, and is energetically linked to the "
            },
            {
              "t": "liver",
