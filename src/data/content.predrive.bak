              "term": "jihva",
              "cat": "ayurveda"
            },
            {
              "t": " ("
            },
            {
              "t": "tongue",
              "term": "tongue",
              "cat": "anatomy"
            },
            {
              "t": ") and is energetically linked to the "
            },
            {
              "t": "lungs",
              "term": "lungs",
              "cat": "anatomy"
            },
            {
              "t": ". The "
            },
            {
              "t": "Vipāka",
              "term": "vipaka",
              "cat": "ayurveda"
            },
            {
              "t": " (post-digestive effect) of "
            },
            {
              "t": "Amla",
              "term": "amla",
              "cat": "ayurveda"
            },
            {
              "t": " (sour) is "
            },
            {
              "t": "Amla",
              "term": "amla",
              "cat": "ayurveda"
            },
            {
              "t": " (sour), which is "
            },
