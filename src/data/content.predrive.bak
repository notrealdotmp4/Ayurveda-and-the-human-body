{
  "title": "The Living Body",
  "subtitle": "Tap any colored word to explore it — red for Ayurveda, amber for physiology, olive for anatomy.",
  "invocation": "IIश्री:II",
  "chapters": [
    {
      "kicker": "Chapter One",
      "title": "The Body’s Levels of Organization",
      "blocks": [
        {
          "type": "level",
          "name": "Chemical",
          "info": "This stage encompasses atoms and molecules, the tiny particles that are the fundamental components of all living organisms. A collection of atoms and molecules organizes to form a cell."
        },
        {
          "type": "level",
          "name": "Cellular",
          "info": "A cell is composed of atoms and molecules and serves as the fundamental unit of life. Many cells join to form a tissue."
        },
        {
          "type": "level",
          "name": "Tissue",
          "info": "A tissue consists of a collection of similar cells that collaborate to perform one or more specialized functions. Many tissues join to form an organ."
        },
        {
          "type": "level",
          "name": "Organ",
          "info": "An organ is a distinct, structured assembly of tissues that function together to perform specific roles within the body. A collection of organs join to form a system."
        },
        {
          "type": "level",
          "name": "System",
          "info": "A system is a collection of interconnected and interdependent organs that collaborate to achieve a particular function or set of functions. A collection of all bodily systems make up the human organism."
        },
        {
          "type": "level",
          "name": "The Human Organism",
          "info": "The human organism, the highest level of complexity, is an integrated structure comprising cells, tissues, organs, and systems. Each level is functionally interconnected and crucial for health, as any change in one part affects multiple processes or structures."
        }
      ]
    },
    {
      "kicker": "Chapter Two",
      "title": "6 Tastes and Stages of Digestion",
      "blocks": [
        {
          "type": "p",
          "segments": [
            {
              "t": "The "
            },
            {
              "t": "digestive system",
              "term": "digestive system",
              "cat": "anatomy"
            },
            {
              "t": " is responsible for converting food into usable nutrients and consists of several key components: the "
            },
            {
              "t": "mouth",
              "term": "mouth",
              "cat": "anatomy"
            },
            {
              "t": ", "
            },
            {
              "t": "pharynx",
              "term": "pharynx",
              "cat": "anatomy"
            },
            {
              "t": ", "
            },
            {
              "t": "esophagus",
              "term": "esophagus",
              "cat": "anatomy"
            },
            {
              "t": ", "
            },
            {
              "t": "stomach",
              "term": "stomach",
              "cat": "anatomy"
            },
            {
              "t": ", "
            },
            {
              "t": "small intestine",
              "term": "small intestine",
              "cat": "anatomy"
            },
            {
              "t": ", and "
            },
            {
              "t": "large intestine/colon",
              "term": "large intestinecolon",
              "cat": "anatomy"
            },
            {
              "t": ". Additionally, accessory organs include the "
            },
            {
              "t": "liver",
              "term": "liver",
              "cat": "anatomy"
            },
            {
              "t": ", "
            },
            {
              "t": "gallbladder",
              "term": "gallbladder",
              "cat": "anatomy"
            },
            {
              "t": ", and "
            },
            {
              "t": "pancreas",
              "term": "pancreas",
              "cat": "anatomy"
            },
            {
              "t": ". Together, these parts facilitate the "
            },
            {
              "t": "mechanical digestion",
              "term": "mechanical digestion",
              "cat": "physiology"
            },
            {
              "t": " and "
            },
            {
              "t": "chemical digestion",
              "term": "chemical digestion",
              "cat": "physiology"
            },
            {
              "t": " of food for nutrient "
            },
            {
              "t": "absorption",
              "term": "absorption",
              "cat": "physiology"
            },
            {
              "t": ". The "
            },
            {
              "t": "digestive system",
              "term": "digestive system",
              "cat": "anatomy"
            },
            {
              "t": " performs five main functions: "
            },
            {
              "t": "ingestion",
              "term": "ingestion",
              "cat": "physiology"
            },
            {
              "t": ", "
            },
            {
              "t": "propulsion",
              "term": "propulsion",
              "cat": "physiology"
            },
            {
              "t": ", "
            },
            {
              "t": "digestion",
              "term": "digestion",
              "cat": "physiology"
            },
            {
              "t": ", "
            },
            {
              "t": "absorption",
              "term": "absorption",
              "cat": "physiology"
            },
            {
              "t": ", and "
            },
            {
              "t": "elimination",
              "term": "elimination",
              "cat": "physiology"
            },
            {
              "t": "."
            }
          ]
        },
        {
          "type": "p",
          "segments": [
            {
              "t": "Madhura Avastha Pāka",
              "term": "madhura avastha paka",
              "cat": "ayurveda"
            },
            {
              "t": ", the sweet stage of "
            },
            {
              "t": "digestion",
              "term": "digestion",
              "cat": "physiology"
            },
            {
              "t": ", begins in "
            },
            {
              "t": "Bodhaka Kapha",
              "term": "bodhaka kapha",
              "cat": "ayurveda"
            },
            {
              "t": ", the "
            },
            {
              "t": "oral cavity",
              "term": "oral cavity",
              "cat": "anatomy"
            },
            {
              "t": ", which governs "
            },
            {
              "t": "salivary secretions",
              "term": "salivary secretions",
              "cat": "physiology"
            },
            {
              "t": " from the "
            },
            {
              "t": "parotid gland",
              "term": "parotid gland",
              "cat": "anatomy"
            },
            {
              "t": ", "
            },
            {
              "t": "submandibular gland",
              "term": "submandibular gland",
              "cat": "anatomy"
            },
            {
              "t": ", and "
            },
            {
              "t": "sublingual glands",
              "term": "sublingual glands",
              "cat": "anatomy"
            },
            {
              "t": " and facilitates the perception of the "
            },
            {
              "t": "6 Rasas",
              "term": "6 rasas",
              "cat": "ayurveda"
            },
            {
              "t": ". "
            },
            {
              "t": "The Bhūtas",
              "term": "the bhutas",
              "cat": "ayurveda"
            },
            {
              "t": " of "
            },
            {
              "t": "Madhura",
              "term": "madhura",
              "cat": "ayurveda"
            },
            {
              "t": " are "
            },
            {
              "t": "Prthivī",
              "term": "prthivi",
              "cat": "ayurveda"
            },
            {
              "t": " (earth) and "
            },
            {
              "t": "Āpas",
              "term": "apas",
              "cat": "ayurveda"
            },
            {
              "t": " (water), representing the principle of "
            },
            {
              "t": "Kapha",
              "term": "kapha",
              "cat": "ayurveda"
            },
            {
              "t": "-predominant "
            },
            {
              "t": "liquefaction",
              "term": "liquefaction",
              "cat": "physiology"
            },
            {
              "t": " that nourishes "
            },
            {
              "t": "asthāyi",
              "term": "asthayi",
              "cat": "ayurveda"
            },
            {
              "t": ", immature "
            },
            {
              "t": "Rasa Dhātu",
              "term": "rasa dhatu",
              "cat": "ayurveda"
            },
            {
              "t": ". Through "
            },
            {
              "t": "mastication",
              "term": "mastication",
              "cat": "physiology"
            },
            {
              "t": ", "
            },
            {
