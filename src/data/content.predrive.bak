            },
            {
              "t": "Kledaka Kapha",
              "term": "kledaka kapha",
              "cat": "ayurveda"
            },
            {
              "t": ", the protective "
            },
            {
              "t": "mucous membrane",
              "term": "mucous membrane",
              "cat": "physiology"
            },
            {
              "t": ", and "
            },
            {
              "t": "Pāchaka Pitta",
              "term": "pachaka pitta",
              "cat": "ayurveda"
            },
            {
              "t": " work in functional integrity to maintain the balance of "
