  <script>
    // Levels-of-Organization scroll scene (Lottie)
    import lottie from 'lottie-web';
    const scene = document.querySelector('.lo-scene');
    if (scene && !document.documentElement.classList.contains('skip-intro')) {
      const stages = [...scene.querySelectorAll('.lo-stage')];
      const steps = [...scene.querySelectorAll('.lo-step')];
      const dotsWrap = document.getElementById('loDots');
      let active = 0;
      const players = stages.map((st) => {
        const lot = st.querySelector('[data-lottie]');
        if (lot) return { type: 'lottie', anim: lottie.loadAnimation({ container: lot, renderer: 'svg', loop: false, autoplay: false, path: lot.dataset.lottie }) };
        const vid = st.querySelector('video[data-video]');
        if (vid) { vid.muted = true; return { type: 'video', el: vid }; }
        return null;
      });
      function playMedia(i) {
        players.forEach((p, n) => {
          if (!p) return;
          if (n === i) { if (p.type === 'lottie') p.anim.goToAndPlay(0, true); else { try { p.el.currentTime = 0; } catch (e) {} p.el.play().catch(() => {}); } }
          else { if (p.type === 'lottie') p.anim.pause(); else p.el.pause(); }
        });
      }
      const dots = stages.map((_, i) => {
        const d = document.createElement('button');
        d.className = 'lo-dot' + (i === 0 ? ' is-on' : '');
        d.setAttribute('aria-label', 'Go to stage ' + (i + 1));
        d.addEventListener('click', () => steps[i].scrollIntoView({ behavior: 'smooth', block: 'center' }));
        dotsWrap.appendChild(d);
        return d;
      });
      function show(i, force) {
        if (i === active && !force) return;
        if (force) { stages[i].classList.remove('is-active'); void stages[i].offsetWidth; }
        stages.forEach((s, n) => s.classList.toggle('is-active', n === i));
        dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
        active = i; playMedia(i);
        if (i === stages.length - 1) { try { localStorage.setItem('seenIntro', '1'); } catch (e) {} }
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) show(+e.target.dataset.step, false); });
      }, { rootMargin: '-50% 0px -50% 0px' });
      steps.forEach((s) => io.observe(s));
      stages[0].classList.add('is-active');
      playMedia(0);
    }
  </script>

