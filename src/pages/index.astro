    function setHeroMode(src, title, showBar) { heroMapSrc = src; const t = document.getElementById('hmTitle'); if (t) t.textContent = title; const bar = document.querySelector('.hm-bar'); if (bar) bar.style.display = showBar ? '' : 'none'; }
    const SIMPLE_ITEMS = [
      { label: "Vāta", video: "/anim/vata.mp4", title: "Vāta", html: "<p>Vāta is the breath of movement — light, airy, and forever in motion, like wind moving through the world. You'll know Vāta by its lightness. The body is thin and slender, tall or small, its bones close to the surface and its proportions delicate. Weight never lingers here. The face is fine and angular, the eyes small and quick, always darting toward the next thing. The skin runs dry, the hair dry and curling. And everything about Vāta hurries — quick steps, restless hands, words that tumble out fast. At its best, this restless energy becomes creativity, joy, and a mind open to anything. But when the wind blows too hard, it scatters — into fear, worry, and thoughts that won't settle.</p>" },
      { label: "Pitta", video: "/anim/pitta.mp4", title: "Pitta", html: "<p>Pitta is the fire within — heat and intensity, the spark that transforms food into energy and ideas into action. You'll know Pitta by its strength. The body is medium and well-built, muscled and steady, holding its shape with ease. The face tapers to a point, cheeks flushed with warmth, the nose sharp, the eyes bright and quick to squint in the light. The skin is fair and easily reddened, scattered with freckles, and the fine hair often greys before its time. At its best, this fire becomes intelligence, discipline, and the courage to lead. But when the flames rise too high, they burn — into anger, impatience, and a perfectionism that spares no one.</p>" },
      { label: "Kapha", video: "/anim/kapha.mp4", title: "Kapha", html: "<p>Kapha is the earth beneath it all — water and soil, the steady force that gives the body form and holds it together. You'll know Kapha by its solidity. The body is broad and strong, built on a generous frame, and weight settles here and stays. The face is large and round as the moon, the cheeks full, the eyes big and gentle beneath thick lashes. The skin is cool, soft, and slow to age; the hair thick and lustrous through the years. Kapha moves without hurry, calm and deep and unshakable. At its best, this steadiness becomes love, compassion, and a forgiving heart. But when the earth grows too heavy, it clings — to comfort, to possessions, to a stillness that won't move.</p>" }
    ];
    const simpleModal = document.getElementById('simpleModal');
    const simpleVid = document.getElementById('simpleVid');
    const simpleText = document.getElementById('simpleText');
    function openSimple(i) {
      const it = SIMPLE_ITEMS[i]; if (!it) return;
      simpleVid.src = it.video;
      simpleText.innerHTML = '<h3 class="simple-title">' + it.title + '</h3>' + it.html; simpleText.scrollTop = 0;
      simpleModal.classList.add('open'); simpleModal.setAttribute('aria-hidden', 'false');
    }
    function closeSimple() { simpleModal.classList.remove('open'); simpleModal.setAttribute('aria-hidden', 'true'); if (simpleVid) simpleVid.pause(); }
    if (simpleModal) {
      document.getElementById('simpleClose').addEventListener('click', closeSimple);
      simpleModal.addEventListener('click', (e) => { if (e.target === simpleModal) closeSimple(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && simpleModal.classList.contains('open')) closeSimple(); });
      document.querySelectorAll('.tri-btn').forEach((b) => b.addEventListener('click', () => openSimple(parseInt(b.dataset.simple, 10))));
    }
    const hmRail = document.getElementById('hmRail');
    const hmText = document.getElementById('hmText');
    const SYS_MAPS = [
      { label: 'Lymphatic System', svg: '/anim/lymphatic-system-map.svg', title: 'The Living Body \u2014 Lymphatic System', html: '<p>The lymphatic system is an open, one-way return system that picks up interstitial fluid, large protein molecules, and cellular debris from the tissues and returns them to the cardiovascular circulation. Unlike the circular cardiovascular system, the lymphatic network begins with microscopic initial vessels, or lymph capillaries, which are "blind-ended" tubes located in the subepidermis. These initial vessels utilize microscopic fibers called anchor filaments to pull open epithelial flaps, allowing the lymph obligatory load—consisting of proteins, cells, and foreign substances—to enter the system.</p><p>Once this fluid enters the vessels, it is called lymph, and it travels from the initial vessels into pre-collectors and then into larger collector vessels, which are the primary vessels for transportation. These collectors contain one-way intralymphatic valves that divide the vessel into functional units called angions, which use spiraled smooth muscle under the control of the autonomic nervous system (ANS) to rhythmically pump the fluid along. The fluid continues through lymphatic trunks and eventually empties into one of the two largest vessels in the network: the right lymphatic duct or the thoracic duct. The thoracic duct handles drainage for three-quarters of the body and begins at a passive collecting well called the cisterna chyli, while the right lymphatic duct drains the upper right quadrant. Both ducts return the cleansed fluid to the blood at the lymphatic terminus, also known as the angulus venosus, which is located where the subclavian veins and jugular veins converge.</p><p>Along this journey, the lymph is filtered by lymph nodes, which are clustered in areas known as catchments, such as the axillary, cervical, inguinal, and popliteal regions. These nodes use lymphocytes and macrophages to remove bacteria and damaged cells, serving as primary sites for immune responses. Additionally, specialized capillaries in the intestines called lacteals perform the unique function of absorbing long-chain fatty acids during digestion. The organization of the system is defined by regional drainage patterns called lymphotomes, which are separated by functional boundaries known as watersheds. Within these watersheds, a high concentration of end-to-end vessel arrangements called anastomoses allows lymph to flow in either direction, providing a crossover route if a collector is blocked.</p><p>The movement of lymph is driven internally by the siphon effect—a negative pressure created at the terminus—and externally by factors like the respiratory pump and skeletal muscle contractions. When this system is overwhelmed or damaged, edema occurs, which is the accumulation of excess fluid in the interstitium. Dynamic edema happens when a healthy system is temporarily overloaded by cardiovascular dysfunction, whereas lymphedema is a specific pathology caused by a congenital defect (primary lymphedema) or damage to the system (secondary lymphedema). Furthermore, traumatic edema is localized swelling following soft tissue injury, and pitting edema is a clinical sign in which pressure leaves a lasting indentation, indicating inefficient fluid return.</p>' },
      { label: 'Circulation', svg: '/anim/vyadhi-marga-map.svg', title: 'The Living Body \u2014 Circulation', html: '<p>Placeholder text for circulation. Edit SYS_MAPS to change this panel.</p>' },
      { label: 'Digestion', svg: '/anim/digestive-map.svg', title: 'The Living Body \u2014 Digestion', html: '<p>Placeholder text for digestion. Edit SYS_MAPS to change this panel.</p>' }
    ];
    function exitSys() { const w = document.querySelector('.hero-win'); if (w) w.classList.remove('sys'); if (hmRail) hmRail.hidden = true; if (hmText) hmText.hidden = true; }
    function selectSys(i) {
