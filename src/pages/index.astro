---
import content from '../data/content.json';
import glossary from '../data/glossary.json';
import '../styles/book.css';

const CATS = {
  ayurveda:   { label: 'Ayurveda',   color: 'var(--c-ayurveda)' },
  physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
  anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
};

const STAGE_MEDIA = [
  { type: 'lottie', src: '/anim/atom.json' },
  { type: 'lottie', src: '/anim/cell.json' },
  { type: 'lottie', src: '/anim/Tissue.json' },
  { type: 'lottie', src: '/anim/Organ.json' },
  { type: 'lottie', src: '/anim/Body.json' },
];
const ART = [
  `<svg viewBox="0 0 120 120" fill="none"><g stroke="var(--c-physiology)" stroke-width="2"><ellipse cx="60" cy="60" rx="46" ry="17"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(60 60 60)"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(120 60 60)"/></g><circle cx="60" cy="60" r="9" fill="var(--ink)"/></svg>`,
  ``, ``, ``, ``,
];

const chapters = content.chapters;
const first = chapters[0];
const isLO = !!(first && first.blocks.some((b) => b.type === 'level'));
const loStages  = isLO ? first.blocks.filter((b) => b.type === 'level' && b.info) : [];
const loOrganism = isLO ? first.blocks.find((b) => b.type === 'level' && !b.info) : null;
const loClosing = isLO ? first.blocks.filter((b) => b.type === 'p') : [];
const rest = isLO ? chapters.slice(1) : chapters;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{content.title} — An Interactive Ayurveda Book</title>
  <script is:inline>try{if(localStorage.getItem('seenIntro'))document.documentElement.classList.add('skip-intro');var _fs=localStorage.getItem('tlb-fontsize');if(_fs)document.documentElement.classList.add(_fs);}catch(e){}</script>
</head>
<body>
  {isLO && (
    <section class="lo">
      <div class="lo-intro">
        {content.invocation && <div class="invocation">{content.invocation}</div>}
        <div class="lo-intro-media" aria-hidden="true">
          <!-- Drop videos here: desktop widescreen 16:9 -> /anim/intro-wide.mp4 ; mobile portrait 9:16 -> /anim/intro-portrait.mp4 -->
          <video class="lo-vid lo-vid-wide" autoplay muted loop playsinline preload="metadata"><source src="/anim/intro-wide.mp4" type="video/mp4" /></video>
          <video class="lo-vid lo-vid-portrait" autoplay muted loop playsinline preload="metadata"><source src="/anim/intro-portrait.mp4" type="video/mp4" /></video>
          <span class="lo-media-ph">video goes here</span>
        </div>
        <div class="lo-kicker">{first.kicker}</div>
        <h1 class="lo-title">{first.title}</h1>
        <div class="lo-hint">scroll to begin ↓</div>
        <button class="lo-revisit" id="loRevisit">↻ Replay</button>
      </div>
      <div class="lo-scene">
        <div class="lo-sticky">
          <div class="lo-art-wrap">
            {loStages.map((s, i) => {
              const m = STAGE_MEDIA[i];
              return (
                <figure class="lo-stage" data-stage={i}>
                  {m && m.type === 'lottie'
                    ? <div class="lo-art" data-lottie={m.src}></div>
                    : m && m.type === 'svg'
                    ? <div class="lo-art"><img class="lo-svg" data-svg src={m.src} alt={s.name} /></div>
                    : <div class="lo-art" set:html={ART[i] || ''}></div>}
                  <figcaption class="lo-cap">
                    <span class="lo-step-no">{i + 1}</span>
                    <h3>{s.name}</h3>
                    <p>{s.info}</p>
                  </figcaption>
                </figure>
              );
            })}
          </div>
          <div class="lo-dots" id="loDots"></div>
        </div>
        {loStages.map((s, i) => (<div class="lo-step" data-step={i}></div>))}
      </div>
      {(loOrganism || loClosing.length > 0) && (
        <div class="lo-synthesis">
          {loOrganism && <h3>{loOrganism.name}</h3>}
          {loClosing.map((b) => (
            <p>{b.segments.map((seg) => (seg.term ? <span class="term" role="button" tabindex="0" data-cat={seg.cat} data-term={seg.term}>{seg.t}</span> : <Fragment>{seg.t}</Fragment>))}</p>
          ))}
        </div>
      )}
    </section>
  )}

  <header class="site">
    <div class="kicker">An Interactive Ayurveda Book</div>
    <h1>{content.title}</h1>
    <p class="sub">{content.subtitle}</p>
    <div class="legend">
      {Object.entries(CATS).map(([k, c]) => (<span><i class="dot" style={`background:${c.color}`}></i> {c.label}</span>))}
    </div>
  </header>

  <div class="wrap">
    {rest.map((ch) => (
      <section>
        <h2 class="chapter">{ch.kicker}</h2>
        <h3>{ch.title}</h3>
        {ch.blocks.map((b) => (
          b.type === 'level' ? (
            <div class="level"><div class="thumb">image<br/>goes here</div><div class="lc"><h4>{b.name}</h4>{b.info && <p>{b.info}</p>}</div></div>
          ) : b.type === 'h' ? (
            <h4 class="subhead">{b.text}</h4>
          ) : b.type === 'list' ? (
            <ul class="bullets">{b.items.map((it) => (<li>{it.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</li>))}</ul>
          ) : (
            <p>{b.segments.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</p>
          )
        ))}
      </section>
    ))}
    <div class="footnote">Red = Ayurveda · Amber = Physiology · Olive = Anatomy. Tap any colored word to explore it; close to return to your place.</div>
  </div>

  <div class="scrim" id="scrim"></div>
  <aside class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-head">
      <button class="close-x" id="closeX" aria-label="Close and return">×</button>
      <span class="cat-pill" id="catPill">Term</span>
      <h3 id="dTitle">Term</h3>
      <div class="phon" id="dPhon"></div>
    </div>
    <div class="drawer-body" id="dBody"></div>
    <div class="back-hint">← Close to jump back exactly where you were reading.</div>
  </aside>

  <!-- Bottom pill navigation -->
  <nav class="toolbar" id="toolbar" aria-label="Reader tools">
    <button class="tbar-btn" data-tool="hero" title="Explore the body" aria-label="Explore the body">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.4"/><path d="M12 8v7M12 15l-4 6M12 15l4 6M5 11l7-2 7 2"/></svg>
    </button>
    <button class="tbar-btn" data-tool="notebook" title="Notebook" aria-label="Notebook">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
    </button>
    <button class="tbar-btn" data-tool="place" title="Place bookmark" aria-label="Place bookmark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v16l-5-4-5 4z"/><path d="M12 8v5M9.5 10.5h5"/></svg>
    </button>
    <button class="tbar-btn" data-tool="jump" title="Jump to bookmark" aria-label="Jump to bookmark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v16l-5-4-5 4z"/><path d="M12 14l-2.5-2.5M12 14l2.5-2.5M12 8v6"/></svg>
    </button>
    <button class="tbar-btn" data-tool="text" title="Text size" aria-label="Text size">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5V6.5h9v2M7.5 6.5v11M5.5 17.5h4"/><path d="M13 13.5v-1.4h8v1.4M17 12.1v6.4M15 18.5h4"/></svg>
    </button>
  </nav>

  <!-- Hero modal -->
  <div class="hero-modal" id="heroModal" aria-hidden="true">
    <div class="hero-win">
      <div class="hm-head"><strong>The Living Body — digestion</strong><button class="close-x" id="heroClose" aria-label="Close">×</button></div>
      <div class="hero-stage">
        <video id="heroVideo" src="/anim/BodyAnimation_ready.mp4" playsinline preload="metadata"></video>
        <div class="hero-map" id="heroMap"></div>
      </div>
      <div class="hm-bar">
        <button id="hmReplay">↻ Replay animation</button>
        <button id="hmExplore">Explore the map →</button>
      </div>
    </div>
  </div>

  <!-- Notebook -->
  <div class="notebook" id="notebook" aria-hidden="true">
    <div class="nb-head"><strong>My notes</strong><button class="close-x" id="nbClose" aria-label="Close">×</button></div>
    <textarea id="nbText" placeholder="Write your notes here… saved automatically on this device."></textarea>
    <div class="nb-bar">
      <button class="primary" id="nbShare">Share</button>
      <button id="nbClear" class="grow">Clear</button>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script id="glossary-data" type="application/json" set:html={JSON.stringify(glossary)} />

  <script>
    const CATS = {
      ayurveda:   { label: 'Ayurveda',   color: 'var(--c-ayurveda)' },
      physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
      anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
    };
    const GLOSSARY = JSON.parse(document.getElementById('glossary-data').textContent);
    const scrim = document.getElementById('scrim');
    const drawer = document.getElementById('drawer');
    const catPill = document.getElementById('catPill');
    const dTitle = document.getElementById('dTitle');
    const dPhon = document.getElementById('dPhon');
    const dBody = document.getElementById('dBody');
    let savedY = 0;
    function openTerm(key) {
      const g = GLOSSARY[key];
      if (!g) return;
      savedY = window.scrollY;
      const cat = CATS[g.cat] || { label: 'Term', color: 'var(--ink)' };
      catPill.textContent = cat.label; catPill.style.background = cat.color;
      dTitle.textContent = g.title; dTitle.style.color = cat.color;
      dPhon.textContent = g.phon || '';
      dBody.innerHTML = g.body || '<p><em>Definition coming soon.</em></p>';
      scrim.classList.add('open'); drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      history.pushState({ term: key }, '');
    }
    function closeTerm(push) {
      scrim.classList.remove('open'); drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      window.scrollTo({ top: savedY });
      if (push && history.state && history.state.term) history.back();
    }
    document.querySelectorAll('.term').forEach((b) => {
      b.addEventListener('click', () => openTerm(b.dataset.term));
      b.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openTerm(b.dataset.term); } });
    });
    document.getElementById('closeX').addEventListener('click', () => closeTerm(true));
    scrim.addEventListener('click', () => closeTerm(true));
    window.addEventListener('popstate', () => closeTerm(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTerm(true); });
    // expose for the hero map to open organ definitions
    window.openGlossary = openTerm;
  </script>

  <script>
    // Levels-of-Organization scroll scene (Lottie)
    import lottie from 'lottie-web';
    const scene = document.querySelector('.lo-scene');
    if (scene && !document.documentElement.classList.contains('skip-intro')) {
      const stages = [...scene.querySelectorAll('.lo-stage')];
      const steps = [...scene.querySelectorAll('.lo-step')];
      const dotsWrap = document.getElementById('loDots');
      let active = 0;
      const players = stages.map((st) => {
        const el = st.querySelector('[data-lottie]');
        if (!el) return null;
        return lottie.loadAnimation({ container: el, renderer: 'svg', loop: false, autoplay: false, path: el.dataset.lottie });
      });
      function playMedia(i) {
        players.forEach((p, n) => { if (p) { if (n === i) { p.goToAndPlay(0, true); } else { p.pause(); } } });
      }
      const dots = stages.map((_, i) => {
        const d = document.createElement('button');
        d.className = 'lo-dot' + (i === 0 ? ' is-on' : '');
        d.setAttribute('aria-label', 'Go to stage ' + (i + 1));
        d.addEventListener('click', () => steps[i].scrollIntoView({ behavior: 'smooth', block: 'center' }));
        dotsWrap.appendChild(d);
        return d;
      });
      function show(i, force) {
        if (i === active && !force) return;
        if (force) { stages[i].classList.remove('is-active'); void stages[i].offsetWidth; }
        stages.forEach((s, n) => s.classList.toggle('is-active', n === i));
        dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
        active = i; playMedia(i);
        if (i === stages.length - 1) { try { localStorage.setItem('seenIntro', '1'); } catch (e) {} }
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) show(+e.target.dataset.step, false); });
      }, { rootMargin: '-50% 0px -50% 0px' });
      steps.forEach((s) => io.observe(s));
      stages[0].classList.add('is-active');
      playMedia(0);
    }
  </script>

  <script>
    // Toolbox + hero modal + notebook + bookmark
    const T = document.getElementById('toast');
    function toast(msg) { T.textContent = msg; T.classList.add('show'); clearTimeout(T._t); T._t = setTimeout(() => T.classList.remove('show'), 1900); }
    const FS_STEPS = ['', 'fs-m', 'fs-l'], FS_LABELS = ['Normal', 'Large', 'Larger'];
    function applyFS(c) { const d = document.documentElement; d.classList.remove('fs-m', 'fs-l'); if (c) d.classList.add(c); try { localStorage.setItem('tlb-fontsize', c); } catch (e) {} }
    function cycleFontSize() { let cur = ''; try { cur = localStorage.getItem('tlb-fontsize') || ''; } catch (e) {} const i = (FS_STEPS.indexOf(cur) + 1) % FS_STEPS.length; applyFS(FS_STEPS[i]); toast('Text size: ' + FS_LABELS[i]); }

    const toolbar = document.getElementById('toolbar');
    const revisitBtn = document.getElementById('loRevisit');
    function revealTools(on) { toolbar.classList.toggle('show', on); if (revisitBtn) revisitBtn.classList.toggle('show', on); }
    const synthEl = document.querySelector('.lo-synthesis');
    if (synthEl) {
      new IntersectionObserver((es) => es.forEach((e) => revealTools(e.isIntersecting || e.boundingClientRect.top < 0)), { threshold: 0 }).observe(synthEl);
    } else {
      revealTools(true);
    }

    // Hero modal
    const heroModal = document.getElementById('heroModal');
    const heroVideo = document.getElementById('heroVideo');
    const heroMap = document.getElementById('heroMap');
    let mapLoaded = false;
    function showVideo() { heroMap.classList.remove('show'); heroVideo.style.display = 'block'; heroVideo.currentTime = 0; heroVideo.play().catch(() => {}); }
    function showMap() { heroVideo.pause(); heroVideo.style.display = 'none'; heroMap.classList.add('show'); loadMap(); }
    function openHero() { heroModal.classList.add('open'); heroModal.setAttribute('aria-hidden', 'false'); showVideo(); }
    function closeHero() { heroModal.classList.remove('open'); heroModal.setAttribute('aria-hidden', 'true'); heroVideo.pause(); }
    function loadMap() {
      if (mapLoaded) return; mapLoaded = true;
      fetch('/anim/digestive-map.svg').then((r) => r.ok ? r.text() : Promise.reject()).then((svg) => {
        heroMap.innerHTML = svg;
        const svgEl = heroMap.querySelector('svg'); if (svgEl) { svgEl.setAttribute('preserveAspectRatio', 'xMidYMin meet'); svgEl.setAttribute('width', '100%'); svgEl.setAttribute('height', '100%'); }
        heroMap.querySelectorAll('[data-term],[id]').forEach((el) => {
          const raw = el.getAttribute('data-term') || el.id; if (!raw) return;
          const key = raw.toLowerCase().replace(/[_-]+/g, ' ').trim();
          el.style.cursor = 'pointer';
          el.addEventListener('click', () => { if (window.openGlossary) window.openGlossary(key); });
        });
      }).catch(() => { heroMap.innerHTML = '<p style="font-family:system-ui,sans-serif;color:var(--ink-soft);text-align:center;max-width:30ch">Interactive map coming soon — drop <b>digestive-map.svg</b> into /public/anim.</p>'; });
    }
    document.getElementById('heroClose').addEventListener('click', closeHero);
    heroModal.addEventListener('click', (e) => { if (e.target === heroModal) closeHero(); });
    document.getElementById('hmReplay').addEventListener('click', showVideo);
    document.getElementById('hmExplore').addEventListener('click', showMap);
    heroVideo.addEventListener('ended', showMap);

    // Notebook
    const notebook = document.getElementById('notebook');
    const nbText = document.getElementById('nbText');
    const NB_KEY = 'tlb-notes';
    try { nbText.value = localStorage.getItem(NB_KEY) || ''; } catch (e) {}
    nbText.addEventListener('input', () => { try { localStorage.setItem(NB_KEY, nbText.value); } catch (e) {} });
    function openNotebook() { notebook.classList.add('open'); notebook.setAttribute('aria-hidden', 'false'); nbText.focus(); }
    document.getElementById('nbClose').addEventListener('click', () => notebook.classList.remove('open'));
    document.getElementById('nbClear').addEventListener('click', () => { if (confirm('Clear all notes?')) { nbText.value = ''; try { localStorage.removeItem(NB_KEY); } catch (e) {} } });
    document.getElementById('nbShare').addEventListener('click', async () => {
      const text = (nbText.value || '').trim();
      if (!text) { toast('Write a note first'); return; }
      const body = text + '\n\n— my notes from The Living Body\n' + location.href;
      const payload = { title: 'My notes — The Living Body', text: body };
      if (navigator.share) { try { await navigator.share(payload); } catch (e) {} }
      else {
        try { await navigator.clipboard.writeText(body); toast('Copied — paste it anywhere'); }
        catch (e) { window.location.href = 'mailto:?subject=' + encodeURIComponent(payload.title) + '&body=' + encodeURIComponent(body); }
      }
    });

    // Bookmark
    const BM_KEY = 'tlb-bookmark';
    function placeBookmark() { try { localStorage.setItem(BM_KEY, String(Math.round(window.scrollY))); toast('Bookmark placed'); } catch (e) {} }
    function jumpBookmark() { let y = null; try { y = localStorage.getItem(BM_KEY); } catch (e) {} if (y === null) { toast('No bookmark yet'); return; } window.scrollTo({ top: +y, behavior: 'smooth' }); }

    toolbar.querySelectorAll('[data-tool]').forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.tool;
      if (t === 'hero') openHero();
      else if (t === 'notebook') openNotebook();
      else if (t === 'place') placeBookmark();
      else if (t === 'jump') jumpBookmark();
      else if (t === 'text') cycleFontSize();
    }));
    const loRevisit = document.getElementById('loRevisit');
    if (loRevisit) loRevisit.addEventListener('click', () => { try { localStorage.removeItem('seenIntro'); } catch (e) {} document.documentElement.classList.remove('skip-intro'); window.scrollTo({ top: 0 }); location.reload(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeHero(); notebook.classList.remove('open'); } });
  </script>
</body>
</html>
