          <div class="sam-cell sam-val" data-grp="dhatus">entire muscle system including smooth, heart, &amp; involuntary muscles</div>
          <div class="sam-cell sam-val" data-grp="dhatus">roma krupa, sites of khamala</div>
          <div class="sam-cell sam-val" data-grp="dhatus">khamala</div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Meda</div>
          <div class="sam-cell sam-val" data-grp="dhatus">snayu</div>
          <div class="sam-cell sam-val" data-grp="dhatus">omentum, vrukka</div>
          <div class="sam-cell sam-val" data-grp="dhatus">subcutaneous fat</div>
          <div class="sam-cell sam-val" data-grp="dhatus">roma kupa</div>
          <div class="sam-cell sam-val" data-grp="dhatus">sveda</div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Asthi</div>
          <div class="sam-cell sam-val" data-grp="dhatus">danta, taruna asthi</div>
          <div class="sam-cell sam-val" data-grp="dhatus">pelvic girdle, sacrum</div>
          <div class="sam-cell sam-val" data-grp="dhatus">skeletal system</div>
          <div class="sam-cell sam-val" data-grp="dhatus">kesha, nakha</div>
          <div class="sam-cell sam-val" data-grp="dhatus">kesha, nakha</div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Majjā</div>
          <div class="sam-cell sam-val" data-grp="dhatus">ashru</div>
          <div class="sam-cell sam-val" data-grp="dhatus">brain, spinal cord, bone marrow, sandhi (joints &amp; junctions between Dhātus)</div>
          <div class="sam-cell sam-val" data-grp="dhatus">central, sympathetic and parasympathetic nervous systems</div>
          <div class="sam-cell sam-val" data-grp="dhatus">synaptic space, neuro-muscular cleft</div>
          <div class="sam-cell sam-val" data-grp="dhatus">akshi sneha, vit sneha</div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Shukra</div>
          <div class="sam-cell sam-val" data-grp="dhatus">OJAS</div>
          <div class="sam-cell sam-val" data-grp="dhatus">testicles, nipples</div>
          <div class="sam-cell sam-val" data-grp="dhatus">vas deferens, epididymis, prostate, urethra, urinogenital tract</div>
          <div class="sam-cell sam-val" data-grp="dhatus">urethral opening</div>
          <div class="sam-cell sam-val" data-grp="dhatus">none, functionally pubic and axillary hair, &amp; secondary sexual characteristics</div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Ārtava</div>
          <div class="sam-cell sam-val" data-grp="dhatus">OJAS</div>
          <div class="sam-cell sam-val" data-grp="dhatus">ovaries, areola of nipples</div>
          <div class="sam-cell sam-val" data-grp="dhatus">fallopian tubes, uterus, cervical canal, vaginal passage (yoni)</div>
          <div class="sam-cell sam-val" data-grp="dhatus">labia minor/major (yoni oshtha)</div>
          <div class="sam-cell sam-val" data-grp="dhatus">none, functionally pubic and axillary hair, &amp; secondary sexual characteristics</div>

          <div class="sam-cell sam-lbl" data-grp="dhatus">Rajah</div>
          <div class="sam-cell sam-empty" data-grp="dhatus"></div>
          <div class="sam-cell sam-val" data-grp="dhatus">fundus of the uterus</div>
          <div class="sam-cell sam-val" data-grp="dhatus">endometrium uterus</div>
          <div class="sam-cell sam-val" data-grp="dhatus">cervix and vaginal passage</div>
          <div class="sam-cell sam-empty" data-grp="dhatus"></div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Stanya</div>
          <div class="sam-cell sam-empty" data-grp="dhatus"></div>
          <div class="sam-cell sam-val" data-grp="dhatus">lactiferous gland</div>
          <div class="sam-cell sam-val" data-grp="dhatus">lactiferous ducts</div>
          <div class="sam-cell sam-val" data-grp="dhatus">duct openings in nipples</div>
          <div class="sam-cell sam-empty" data-grp="dhatus"></div>

          <button class="sr-group" data-group="mala" aria-expanded="true"><span>The eliminating channels</span><span class="sr-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></span></button>
          <div class="sam-cell sam-lbl" data-grp="mala">Purīsha</div>
          <div class="sam-cell sam-empty" data-grp="mala"></div>
          <div class="sam-cell sam-val" data-grp="mala">cecum, rectum, sigmoid colon</div>
          <div class="sam-cell sam-val" data-grp="mala">large intestine</div>
          <div class="sam-cell sam-val" data-grp="mala">anal orifice</div>
          <div class="sam-cell sam-empty" data-grp="mala"></div>
          <div class="sam-cell sam-lbl" data-grp="mala">Mūtra</div>
          <div class="sam-cell sam-empty" data-grp="mala"></div>
          <div class="sam-cell sam-val" data-grp="mala">kidneys</div>
          <div class="sam-cell sam-val" data-grp="mala">ureter, bladder, urethra</div>
          <div class="sam-cell sam-val" data-grp="mala">urethral opening</div>
          <div class="sam-cell sam-empty" data-grp="mala"></div>
          <div class="sam-cell sam-lbl" data-grp="mala">Sveda</div>
          <div class="sam-cell sam-empty" data-grp="mala"></div>
          <div class="sam-cell sam-val" data-grp="mala">sebaceous glands, sweat glands</div>
          <div class="sam-cell sam-val" data-grp="mala">sebaceous ducts, sweat ducts</div>
          <div class="sam-cell sam-val" data-grp="mala">sweat duct, openings in pores of skin</div>
          <div class="sam-cell sam-empty" data-grp="mala"></div>

          <button class="sr-group" data-group="mano" aria-expanded="true"><span>The mind channel</span><span class="sr-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></span></button>
          <div class="sam-cell sam-lbl" data-grp="mano">Mano</div>
          <div class="sam-cell sam-empty" data-grp="mano"></div>
          <div class="sam-cell sam-val" data-grp="mano">heart, cardiac plexus, brain, chakra system</div>
          <div class="sam-cell sam-val" data-grp="mano">entire body</div>
          <div class="sam-cell sam-val" data-grp="mano">sensory organs, marma points</div>
          <div class="sam-cell sam-val" data-grp="mano">excess rajas and tamas qualities</div>
        </div>
      </div>
    </figure>

    <div class="map-cta-wrap">
      <button class="map-btn" id="mapCta2" aria-label="Open the circulation map">
        <img src="/anim/magras.svg" alt="" />
        <span>Mārga</span>
      </button>
    </div>
    <img class="lo-dinkus" src="/anim/dinkusLast.svg" alt="" />

    <figure class="samprapti">
      <figcaption class="sam-title">Samprāpti</figcaption>
