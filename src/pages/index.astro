---
import content from '../data/content.json';
import glossary from '../data/glossary.json';
import tridosha from '../data/tridosha.json';
import systems from '../data/systems.json';
import agnis from '../data/agnis.json';
import '../styles/book.css';
import fs from 'node:fs';
let ICON_FILES = [];
try { ICON_FILES = fs.readdirSync('public/anim/icons').filter((f) => /\.(svg|png)$/i.test(f)); } catch (e) {}

const CATS = {
  ayurveda:   { label: 'Āyurveda',   color: 'var(--c-ayurveda)' },
  physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
  anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
};

const STAGE_MEDIA = [
  { type: 'lottie', src: '/anim/atom.json' },
  { type: 'lottie', src: '/anim/cell.json' },
  { type: 'lottie', src: '/anim/Tissue.json' },
  { type: 'lottie', src: '/anim/Organ.json' },
  { type: 'svg', src: '/anim/BodyCloseup.svg' },
  { type: 'svg', src: '/anim/BodyMainClothes.svg' },
];
const ART = [
  `<svg viewBox="0 0 120 120" fill="none"><g stroke="var(--c-physiology)" stroke-width="2"><ellipse cx="60" cy="60" rx="46" ry="17"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(60 60 60)"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(120 60 60)"/></g><circle cx="60" cy="60" r="9" fill="var(--ink)"/></svg>`,
  ``, ``, ``, ``,
];

const chapters = content.chapters;
const first = chapters[0];
const isLO = !!(first && first.blocks.some((b) => b.type === 'level'));
const loStages  = isLO ? first.blocks.filter((b) => b.type === 'level' && b.info) : [];
const loOrganism = isLO ? first.blocks.find((b) => b.type === 'level' && !b.info) : null;
const loClosing = isLO ? first.blocks.filter((b) => b.type === 'p') : [];
const loOrganismText = loClosing.map((b) => b.segments.map((s) => s.t).join('')).join(' ');
const loSlides = loOrganism ? [...loStages, { name: loOrganism.name, info: loOrganismText }] : loStages;
const rest = isLO ? chapters.slice(1) : chapters;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>{content.title} — An Interactive Āyurveda Book</title>
  <script is:inline>try{if(localStorage.getItem('seenIntro'))document.documentElement.classList.add('skip-intro');var _fs=localStorage.getItem('tlb-fontsize');if(_fs)document.documentElement.classList.add(_fs);}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Noto+Sans:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  {isLO && (
    <section class="lo">
      <div class="lo-intro">
        {content.invocation && <div class="invocation">{content.invocation}</div>}
        <div class="book-eyebrow">An Interactive Āyurveda Book</div>
        <div class="lo-intro-media">
          <!-- One intro video (with sound) for desktop and mobile; tap to play. -->
          <video class="lo-vid" id="introVid" playsinline preload="metadata" poster="/anim/intro-poster.jpg"><source src="/anim/intro-wide.mp4" type="video/mp4" /></video>
          <button class="lo-play" id="introPlay" aria-label="Play the intro video" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
          </button>
          <button class="lo-pause" id="introPause" aria-label="Pause the video" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
          </button>
        </div>
        <p class="lo-lead">The Pañcha Mahabhutas are the basic elements that make up everything around us. At the smallest level, everything is made of atoms, which are tiny particles consisting of protons, neutrons, and electrons. When many atoms join together, they form molecules. These molecules are the basic level of organization in the human body.</p>
        <div class="intro-note">
          <p class="sub">Tap any colored word or button to explore it</p>
          <div class="legend">
            {['physiology', 'ayurveda', 'anatomy'].map((k) => (<span><i class="dot" style={`background:${CATS[k].color}`}></i> {CATS[k].label}</span>))}
          </div>
        </div>
        <button class="map-btn" id="philBtn" aria-label="Shad Darshan — the six philosophies">
          <img src="/anim/phylosophies.svg" alt="" />
          <span>Vidyā</span>
        </button>
        <img class="lo-dinkus" src="/anim/dinkusFirst.svg" alt="" />
        <div class="lo-kicker">{first.kicker}</div>
        <h1 class="lo-title">{first.title}</h1>
        <div class="lo-hint">scroll to begin ↓</div>
      </div>
      <div class="lo-scene">
        <div class="lo-sticky">
          <div class="lo-art-wrap">
            {loSlides.map((s, i) => {
              const m = STAGE_MEDIA[i];
              return (
                <figure class="lo-stage" data-stage={i}>
                  {m && m.type === 'lottie'
                    ? <div class="lo-art" data-lottie={m.src}></div>
                    : m && m.type === 'svg'
                    ? <div class="lo-art"><img class="lo-svg" data-svg src={m.src} alt={s.name} /></div>
                    : m && m.type === 'video'
                    ? <div class="lo-art"><video class="lo-svg" data-video src={m.src} muted loop playsinline preload="metadata"></video></div>
                    : <div class="lo-art" set:html={ART[i] || ''}></div>}
                  <figcaption class="lo-cap">
                    <span class="lo-step-no">{i + 1}</span>
                    <h3>{s.name}</h3>
                    <p>{s.info}</p>
                  </figcaption>
                </figure>
              );
            })}
          </div>
          <div class="lo-dots" id="loDots"></div>
        </div>
        {loSlides.map((s, i) => (<div class="lo-step" data-step={i}></div>))}
        {loSlides.length > 0 && <div class="lo-step lo-step-hold" data-step={loSlides.length - 1}></div>}
      </div>
    </section>
  )}

  <div class="lo-revisit-wrap"><button class="lo-revisit" id="loRevisit">↻ Replay the slides</button></div>

  <header class="site">
    <div class="tri-headline">Tridosha</div>
    <div class="tri-btns">
      <div class="tri-item">
        <button class="tri-btn" data-simple="0" aria-label="Vāta"><img src="/anim/tri-vata.svg" alt="" data-label="Vāta" onerror="var s=document.createElement('span');s.className='tri-fallback';s.textContent=this.dataset.label;this.replaceWith(s)" /></button>
      </div>
      <div class="tri-item">
        <button class="tri-btn" data-simple="1" aria-label="Pitta"><img src="/anim/tri-pitta.svg" alt="" data-label="Pitta" onerror="var s=document.createElement('span');s.className='tri-fallback';s.textContent=this.dataset.label;this.replaceWith(s)" /></button>
      </div>
      <div class="tri-item">
        <button class="tri-btn" data-simple="2" aria-label="Kapha"><img src="/anim/tri-kapha.svg" alt="" data-label="Kapha" onerror="var s=document.createElement('span');s.className='tri-fallback';s.textContent=this.dataset.label;this.replaceWith(s)" /></button>
      </div>
    </div>
    <section class="arch">
      <img class="dinkus-ganesh" src="/anim/dinkusWider.svg" alt="" />
      <h2 class="arch-title">The Āyurvedic Architecture</h2>
      <p class="arch-intro">In Āyurvedic philosophy, the concepts of Trayopastambha, Tridanda, and Purushārtha constitute an integrated framework that links daily lifestyle choices with human existence and the overarching purpose of life.</p>
      <div class="arch-cols">
        <div class="arch-item">
          <img src="/anim/arch-1.jpg" alt="Trayopastambha" />
          <h3 class="arch-item-title">Trayopastambha</h3>
          <p>The three pillars of daily life: Āhāra, wholesome, tailored nutrition; Nidrā, restorative sleep for tissue repair and mental renewal; and Brahmacharya, conservation of vital and sexual energy for stamina and resilience. These pillars sustain the Tridanda, the three foundations of the living being.</p>
        </div>
        <div class="arch-item">
          <img src="/anim/arch-2.jpg" alt="Tridanda" />
          <h3 class="arch-item-title">Tridanda</h3>
          <p>The three foundations of life: Sharira, the physical body of elements; Sattva, the mind, clarity, emotion, perception; and Ātma, the immortal soul that animates both. When the pillars stabilize the foundations, one gains the strength and clarity to pursue the Purushārtha, life's four goals.</p>
        </div>
        <div class="arch-item">
          <img src="/anim/arch-3.jpg" alt="Purushārtha" />
          <h3 class="arch-item-title">Purushārtha</h3>
          <p>The four aims of life: Dharma, ethical duty and righteousness, which frames Artha, wealth and material security, within which one enjoys Kama, sensory pleasure, love, beauty, ultimately leading to Moksha, the spiritual liberation.</p>
        </div>
      </div>
    </section>
    <img class="dinkus-ganesh" src="/anim/dinkusWider.svg" alt="" />
    <h1>{content.title}</h1>
  </header>

  <div class="map-cta-wrap">
    <button class="map-btn" id="mapCta" aria-label="Open the body map">
      <img src="/anim/digestive.svg" alt="" />
      <span>Agni</span>
    </button>
  </div>
  <img class="lo-dinkus" src="/anim/dinkusSecond.svg" alt="" />

  <div class="wrap">
    {rest.map((ch) => (
      <section>
        <h2 class="chapter">{ch.kicker}</h2>
        <h3>{ch.title.includes(' & ') ? (
          <Fragment>{ch.title.split(' & ')[0]} &<br/>{ch.title.split(' & ').slice(1).join(' & ')}</Fragment>
        ) : ch.title}</h3>
        {ch.blocks.map((b, bi) => (
          b.type === 'level' ? (
            <div class="level"><div class="thumb">image<br/>goes here</div><div class="lc"><h4>{b.name}</h4>{b.info && <p>{b.info}</p>}</div></div>
          ) : b.type === 'h' ? (
            <h4 class={b.level === 2 ? 'subhead subhead-lg' : 'subhead'}>{b.text}</h4>
          ) : b.type === 'list' ? (
            <ul class="bullets">{b.items.map((it) => (<li>{it.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</li>))}</ul>
          ) : bi === 0 && b.type === 'p' ? (
            <p class="chapter-intro">{b.segments.map((s) => s.t).join('')}</p>
          ) : b.num ? (
            <div class="stage">
              <button class="stage-toggle" type="button" aria-expanded="false">
                <span class="stage-label">{b.num}. {b.segments[0].t}</span>
                <span class="stage-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
              </button>
              <div class="stage-panel" hidden>
                <p>{b.segments.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</p>
              </div>
            </div>
          ) : (
            <p>{b.segments.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</p>
          )
        ))}
      </section>
    ))}

    <div class="tongue-illustration"><img src="/anim/tongue.png" alt="" /></div>
    <div class="chapter-dinkus"><br/><br/><img src="/anim/dinkusWider.svg" alt="" /><br/><br/></div>

    <figure class="samprapti">
      <figcaption class="sam-title">Srotāmsi Dhātu</figcaption>
      <div class="sam-scroll">
        <div class="sr-grid">
          <div class="sam-cell sam-hd">Srotāmsi Dhātu</div>
          <div class="sam-cell sam-hd">Upa-Dhātu</div>
          <div class="sam-cell sam-hd">Mūla</div>
          <div class="sam-cell sam-hd">Mārga</div>
          <div class="sam-cell sam-hd">Mukha</div>
          <div class="sam-cell sam-hd">Mala</div>

          <button class="sr-group" data-group="intake" aria-expanded="true"><span>The receiving channels</span><span class="sr-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></span></button>
          <div class="sam-cell sam-lbl" data-grp="intake">Prāna</div>
          <div class="sam-cell sam-empty" data-grp="intake"></div>
          <div class="sam-cell sam-val" data-grp="intake">left chamber of heart, maha srotas</div>
          <div class="sam-cell sam-val" data-grp="intake">respiratory tract, bronchial tree, alveoli</div>
          <div class="sam-cell sam-val" data-grp="intake">nasa</div>
          <div class="sam-cell sam-val" data-grp="intake">carbon dioxide</div>
          <div class="sam-cell sam-lbl" data-grp="intake">Ambu</div>
          <div class="sam-cell sam-empty" data-grp="intake"></div>
          <div class="sam-cell sam-val" data-grp="intake">kloma, tālu, choroid plexus</div>
          <div class="sam-cell sam-val" data-grp="intake">GI mucous membrane</div>
          <div class="sam-cell sam-val" data-grp="intake">vrukka, jihvā, roma kupa</div>
          <div class="sam-cell sam-val" data-grp="intake">mūtra, sveda</div>
          <div class="sam-cell sam-lbl" data-grp="intake">Anna</div>
          <div class="sam-cell sam-empty" data-grp="intake"></div>
          <div class="sam-cell sam-val" data-grp="intake">esophagus, stomach fundus</div>
          <div class="sam-cell sam-val" data-grp="intake">maha srotas — lips to ileocecal valve</div>
          <div class="sam-cell sam-val" data-grp="intake">ileocecal valve</div>
          <div class="sam-cell sam-val" data-grp="intake">purīsha</div>

          <button class="sr-group" data-group="dhatus" aria-expanded="true"><span>The nourishing channels</span><span class="sr-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></span></button>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Rasa</div>
          <div class="sam-cell sam-val" data-grp="dhatus">twak, stanya, rajah</div>
          <div class="sam-cell sam-val" data-grp="dhatus">right chamber of heart, 10 great vessels</div>
          <div class="sam-cell sam-val" data-grp="dhatus">venous system, lymphatic system</div>
          <div class="sam-cell sam-val" data-grp="dhatus">arteriole/venous junctions</div>
          <div class="sam-cell sam-val" data-grp="dhatus">Poshaka Kapha</div>
          <div class="sam-cell sam-lbl" data-grp="dhatus">Rakta</div>
          <div class="sam-cell sam-val" data-grp="dhatus">sira, kandara</div>
          <div class="sam-cell sam-val" data-grp="dhatus">yakrut, pliha</div>
          <div class="sam-cell sam-val" data-grp="dhatus">circulatory system</div>
          <div class="sam-cell sam-val" data-grp="dhatus">arteriole/venous junctions</div>
          <div class="sam-cell sam-val" data-grp="dhatus">Poshaka Pitta</div>
