  <script id="icon-files" type="application/json" set:html={JSON.stringify(ICON_FILES)} />

  <script>
    const CATS = {
      ayurveda:   { label: 'Āyurveda',   color: 'var(--c-ayurveda)' },
      physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
      anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
    };
    const GLOSSARY = JSON.parse(document.getElementById('glossary-data').textContent);
    const ICON_FILES = JSON.parse((document.getElementById('icon-files') || {}).textContent || '[]');
    const ICON_MAP = {};
    ICON_FILES.forEach((f) => { const n = f.replace(/\.(svg|png)$/i, '').toLowerCase().replace(/[-_\s]+/g, ' ').trim(); if (!(n in ICON_MAP)) ICON_MAP[n] = f; });
    window.iconHTML = function (key) {
      const n = (key || '').toLowerCase().replace(/[-_\s]+/g, ' ').trim();
      const f = ICON_MAP[n];
      if (!f) return '';
      const wide = /avastha paka$/.test(n);
      if (!wide) return '';
      return '<img class="def-icon def-icon-wide" src="/anim/icons/' + encodeURIComponent(f) + '" alt="">';
    };
    let CONNECTIONS = null;
    function relFold(s) { return (s || '').normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
    function buildConnections() {
      const keys = Object.keys(GLOSSARY);
      const entries = keys.map((k) => ({ k, t: relFold(GLOSSARY[k].title || k) })).filter((e) => e.t.length > 2).sort((a, b) => b.t.length - a.t.length);
      const titleToKey = {}; entries.forEach((e) => { if (!(e.t in titleToKey)) titleToKey[e.t] = e.k; });
      const alt = entries.map((e) => e.t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
      const re = new RegExp('\\b(' + alt + ')\\b', 'g');
      const out = {}; keys.forEach((k) => out[k] = new Set());
      keys.forEach((k) => { const body = relFold((GLOSSARY[k].body || '').replace(/<[^>]+>/g, ' ')); let m; re.lastIndex = 0; while ((m = re.exec(body))) { const o = titleToKey[m[1]]; if (o && o !== k) { out[k].add(o); out[o].add(k); } } });
      CONNECTIONS = out;
    }
    function relatedHTML(key, exclDoshas) {
      if (!CONNECTIONS) buildConnections();
      let rel = [...(CONNECTIONS[key] || [])];
      if (exclDoshas) rel = rel.filter((k) => k !== 'vata dosha' && k !== 'pitta dosha' && k !== 'kapha dosha');
      if (!rel.length) return '';
      rel = rel.map((k) => ({ k, title: GLOSSARY[k].title || k, cat: GLOSSARY[k].cat })).sort((a, b) => a.title.localeCompare(b.title)).slice(0, 18);
      const chips = rel.map((r) => '<button class="rel-chip" data-term="' + r.k.replace(/"/g, '&quot;') + '"><i class="rel-dot" style="background:' + ((CATS[r.cat] && CATS[r.cat].color) || 'var(--ink)') + '"></i>' + r.title + '</button>').join('');
      return '<div class="rel-explore"><div class="rel-label">Connected terms</div><div class="rel-chips">' + chips + '</div></div>';
    }
    const DOSHAS = [
      { key: 'vata dosha', label: 'Vata', emoji: '💨', slug: 'vata-dosha' },
      { key: 'pitta dosha', label: 'Pitta', emoji: '🔥', slug: 'pitta-dosha' },
      { key: 'kapha dosha', label: 'Kapha', emoji: '🌊', slug: 'kapha-dosha' },
    ];
    function doshaFor(g) {
      const t = ((g.title || '') + ' ' + (g.body || '')).normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase();
      const hits = [];
      if (/\bvata\b/.test(t)) hits.push('vata dosha');
      if (/\bpitta\b/.test(t)) hits.push('pitta dosha');
      if (/\bkapha\b/.test(t)) hits.push('kapha dosha');
      return hits.length === 1 ? hits[0] : null;
    }
    function doshaExploreHTML(cur) {
      const cards = DOSHAS.map((d) => '<button class="de-card' + (d.key === cur ? ' is-on' : '') + '" data-term="' + d.key + '"><span class="de-ic"><img class="de-img" src="/anim/icons/' + d.slug + '.svg" alt="" data-emoji="' + d.emoji + '"></span><span class="de-lbl">' + d.label + '</span></button>').join('');
      return '<div class="dosha-explore"><div class="de-label">Explore the doshas</div><div class="de-cards">' + cards + '</div></div>';
    }
    const scrim = document.getElementById('scrim');
    const drawer = document.getElementById('drawer');
    const catPill = document.getElementById('catPill');
    const dTitle = document.getElementById('dTitle');
    const dPhon = document.getElementById('dPhon');
    const dBody = document.getElementById('dBody');
    const attachScrollHint = function (scrollEl, host) {
      const hint = document.createElement('div');
      hint.className = 'scroll-hint'; hint.innerHTML = 'Scroll <span class="sh-arrow">\u2193</span>';
      host.appendChild(hint);
      const upd = () => {
        const more = scrollEl.scrollHeight - scrollEl.clientHeight - scrollEl.scrollTop > 14;
        if (more) { const r = scrollEl.getBoundingClientRect(), hr = host.getBoundingClientRect(); hint.style.bottom = Math.max(6, hr.bottom - r.bottom + 8) + 'px'; }
        hint.classList.toggle('show', more);
      };
      scrollEl.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd);
      return upd;
    };
    const drawerHint = attachScrollHint(dBody, drawer);
    let savedY = 0;
    function openTerm(key) {
      const g = GLOSSARY[key];
      if (!g) return;
      savedY = window.scrollY;
      const cat = CATS[g.cat] || { label: 'Term', color: 'var(--ink)' };
      catPill.textContent = cat.label; catPill.style.background = cat.color;
      dTitle.textContent = g.title; dTitle.style.color = cat.color;
      dPhon.textContent = g.phon || '';
      dBody.innerHTML = window.iconHTML(key) + (g.body || '<p><em>Definition coming soon.</em></p>');
      const _dk = doshaFor(g);
      if (_dk) {
        dBody.insertAdjacentHTML('beforeend', doshaExploreHTML(_dk));
        dBody.querySelectorAll('.de-card').forEach((c) => {
          c.addEventListener('click', () => openTerm(c.dataset.term));
          const im = c.querySelector('img'); if (im) im.addEventListener('error', () => { const sp = document.createElement('span'); sp.className = 'de-emoji'; sp.textContent = im.dataset.emoji; im.replaceWith(sp); });
        });
      }
      const _rel = relatedHTML(key, !!_dk);
      if (_rel) { dBody.insertAdjacentHTML('beforeend', _rel); dBody.querySelectorAll('.rel-chip').forEach((c) => c.addEventListener('click', () => openTerm(c.dataset.term))); }
      dBody.scrollTop = 0; requestAnimationFrame(drawerHint);
      scrim.classList.add('open'); drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      history.pushState({ term: key }, '');
    }
    function closeTerm(push) {
      scrim.classList.remove('open'); drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      window.scrollTo({ top: savedY });
      if (push && history.state && history.state.term) history.back();
    }
    document.querySelectorAll('.term').forEach((b) => {
      b.addEventListener('click', () => openTerm(b.dataset.term));
      b.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openTerm(b.dataset.term); } });
    });
    document.getElementById('closeX').addEventListener('click', () => closeTerm(true));
    scrim.addEventListener('click', () => closeTerm(true));
    window.addEventListener('popstate', () => closeTerm(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTerm(true); });
    // expose for the hero map to open organ definitions
    window.openGlossary = openTerm;
    // ---------- Search ----------
    const searchModal = document.getElementById('searchModal');
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    let searchIndex = null;
    function buildSearchIndex() {
      const idx = [];
      document.querySelectorAll('.wrap section').forEach((sec) => {
        const chap = (sec.querySelector('h2.chapter') || {}).textContent || '';
        const title = (sec.querySelector('h3') || {}).textContent || '';
        sec.querySelectorAll('p, li, h4.subhead').forEach((el) => {
          const text = (el.textContent || '').trim();
          if (text.length > 2) idx.push({ el: el, text: text, label: (chap.trim() + ' · ' + title.trim()).replace(/^ · | · $/, '') });
        });
      });
      return idx;
    }
    function escHtml(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
    function snippet(text, q) {
      const i = text.toLowerCase().indexOf(q);
      if (i < 0) return escHtml(text.slice(0, 140));
      const a = Math.max(0, i - 55), b = Math.min(text.length, i + q.length + 95);
      return (a > 0 ? '…' : '') + escHtml(text.slice(a, i)) + '<mark>' + escHtml(text.slice(i, i + q.length)) + '</mark>' + escHtml(text.slice(i + q.length, b)) + (b < text.length ? '…' : '');
    }
    function runSearch() {
      const raw = searchInput.value.trim(), q = raw.toLowerCase();
      if (q.length < 2) { searchResults.innerHTML = '<div class="sr-hint">Type at least two letters to search.</div>'; return; }
      if (!searchIndex) searchIndex = buildSearchIndex();
      let html = '';
      const terms = [];
      for (const k in GLOSSARY) {
        const g = GLOSSARY[k];
        const t = (g.title || '').toLowerCase();
        const body = (g.body || '').replace(/<[^>]+>/g, ' ').toLowerCase();
        if (t.includes(q) || body.includes(q)) terms.push([k, g, t.startsWith(q) ? 0 : (t.includes(q) ? 1 : 2)]);
      }
