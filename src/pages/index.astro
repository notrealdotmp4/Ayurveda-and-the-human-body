---
import content from '../data/content.json';
import glossary from '../data/glossary.json';
import '../styles/book.css';
import fs from 'node:fs';
let ICON_FILES = [];
try { ICON_FILES = fs.readdirSync('public/anim/icons').filter((f) => /\.(svg|png)$/i.test(f)); } catch (e) {}

const CATS = {
  ayurveda:   { label: 'Ayurveda',   color: 'var(--c-ayurveda)' },
  physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
  anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
};

const STAGE_MEDIA = [
  { type: 'lottie', src: '/anim/atom.json' },
  { type: 'lottie', src: '/anim/cell.json' },
  { type: 'lottie', src: '/anim/Tissue.json' },
  { type: 'lottie', src: '/anim/Organ.json' },
  { type: 'svg', src: '/anim/BodyCloseup.svg' },
  { type: 'video', src: '/anim/introWoman.mp4' },
];
const ART = [
  `<svg viewBox="0 0 120 120" fill="none"><g stroke="var(--c-physiology)" stroke-width="2"><ellipse cx="60" cy="60" rx="46" ry="17"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(60 60 60)"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(120 60 60)"/></g><circle cx="60" cy="60" r="9" fill="var(--ink)"/></svg>`,
  ``, ``, ``, ``,
];

const chapters = content.chapters;
const first = chapters[0];
const isLO = !!(first && first.blocks.some((b) => b.type === 'level'));
const loStages  = isLO ? first.blocks.filter((b) => b.type === 'level' && b.info) : [];
const loOrganism = isLO ? first.blocks.find((b) => b.type === 'level' && !b.info) : null;
const loClosing = isLO ? first.blocks.filter((b) => b.type === 'p') : [];
const loOrganismText = loClosing.map((b) => b.segments.map((s) => s.t).join('')).join(' ');
const loSlides = loOrganism ? [...loStages, { name: loOrganism.name, info: loOrganismText }] : loStages;
const rest = isLO ? chapters.slice(1) : chapters;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>{content.title} — An Interactive Ayurveda Book</title>
  <script is:inline>try{if(localStorage.getItem('seenIntro'))document.documentElement.classList.add('skip-intro');var _fs=localStorage.getItem('tlb-fontsize');if(_fs)document.documentElement.classList.add(_fs);}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Noto+Sans:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  {isLO && (
    <section class="lo">
      <div class="lo-intro">
        {content.invocation && <div class="invocation">{content.invocation}</div>}
        <div class="book-eyebrow">An Interactive Ayurveda Book</div>
        <div class="lo-intro-media">
          <!-- One intro video (with sound) for desktop and mobile; tap to play. -->
          <video class="lo-vid" id="introVid" playsinline preload="metadata" poster="/anim/intro-poster.jpg"><source src="/anim/intro-wide.mp4" type="video/mp4" /></video>
          <button class="lo-play" id="introPlay" aria-label="Play the intro video" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
          </button>
          <button class="lo-pause" id="introPause" aria-label="Pause the video" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
          </button>
        </div>
        <p class="lo-lead">The Pañcha Mahabhutas are the basic elements that make up everything around us. At the smallest level, everything is made of atoms, which are tiny particles consisting of protons, neutrons, and electrons. When many atoms join together, they form molecules. These molecules are the basic level of organization in the human body.</p>
        <button class="map-btn" id="philBtn" aria-label="Shad Darshan — the six philosophies">
          <img src="/anim/phylosophies.svg" alt="" />
          <span>Shad Darshan</span>
        </button>
        <img class="lo-dinkus" src="/anim/dinkusFirst.svg" alt="" />
        <div class="lo-kicker">{first.kicker}</div>
        <h1 class="lo-title">{first.title}</h1>
        <div class="lo-hint">scroll to begin ↓</div>
      </div>
      <div class="lo-scene">
        <div class="lo-sticky">
          <div class="lo-art-wrap">
            {loSlides.map((s, i) => {
              const m = STAGE_MEDIA[i];
              return (
                <figure class="lo-stage" data-stage={i}>
                  {m && m.type === 'lottie'
                    ? <div class="lo-art" data-lottie={m.src}></div>
                    : m && m.type === 'svg'
                    ? <div class="lo-art"><img class="lo-svg" data-svg src={m.src} alt={s.name} /></div>
                    : m && m.type === 'video'
                    ? <div class="lo-art"><video class="lo-svg" data-video src={m.src} muted loop playsinline preload="metadata"></video></div>
                    : <div class="lo-art" set:html={ART[i] || ''}></div>}
                  <figcaption class="lo-cap">
                    <span class="lo-step-no">{i + 1}</span>
                    <h3>{s.name}</h3>
                    <p>{s.info}</p>
                  </figcaption>
                </figure>
              );
            })}
          </div>
          <div class="lo-dots" id="loDots"></div>
        </div>
        {loSlides.map((s, i) => (<div class="lo-step" data-step={i}></div>))}
        {loSlides.length > 0 && <div class="lo-step lo-step-hold" data-step={loSlides.length - 1}></div>}
      </div>
    </section>
  )}

  <div class="lo-revisit-wrap"><button class="lo-revisit" id="loRevisit">↻ Replay the slides</button></div>

  <header class="site">
    <div class="tri-headline">Tri Dosha</div>
    <div class="tri-btns">
      <div class="tri-item">
        <button class="tri-btn" data-simple="0" aria-label="Vāta"><img src="/anim/tri-vata.svg" alt="" data-label="Vāta" onerror="var s=document.createElement('span');s.className='tri-fallback';s.textContent=this.dataset.label;this.replaceWith(s)" /></button>
        <span class="tri-label">Vāta</span>
      </div>
      <div class="tri-item">
        <button class="tri-btn" data-simple="1" aria-label="Pitta"><img src="/anim/tri-pitta.svg" alt="" data-label="Pitta" onerror="var s=document.createElement('span');s.className='tri-fallback';s.textContent=this.dataset.label;this.replaceWith(s)" /></button>
        <span class="tri-label">Pitta</span>
      </div>
      <div class="tri-item">
        <button class="tri-btn" data-simple="2" aria-label="Kapha"><img src="/anim/tri-kapha.svg" alt="" data-label="Kapha" onerror="var s=document.createElement('span');s.className='tri-fallback';s.textContent=this.dataset.label;this.replaceWith(s)" /></button>
        <span class="tri-label">Kapha</span>
      </div>
    </div>
    <h1>{content.title}</h1>
    <p class="sub">Tap any colored word and button to explore it</p>
    <div class="legend">
      {['physiology', 'anatomy', 'ayurveda'].map((k) => (<span><i class="dot" style={`background:${CATS[k].color}`}></i> {CATS[k].label}</span>))}
    </div>
  </header>

  <div class="map-cta-wrap">
    <button class="map-btn" id="mapCta" aria-label="Open the body map">
      <img src="/anim/digestive.svg" alt="" />
      <span>Digestion Map</span>
    </button>
  </div>
  <img class="lo-dinkus" src="/anim/dinkusSecond.svg" alt="" />

  <div class="wrap">
    {rest.map((ch) => (
      <section>
        {ch.kicker === 'Chapter Three' && (
          <div class="map-cta-wrap">
            <button class="map-btn" id="mapCta2" aria-label="Open the circulation map">
              <img src="/anim/magras.svg" alt="" />
              <span>Channels Map</span>
            </button>
          </div>
          <img class="lo-dinkus" src="/anim/dinkusLast.svg" alt="" />
        )}
        <h2 class="chapter">{ch.kicker}</h2>
        <h3>{ch.title}</h3>
        {ch.blocks.map((b) => (
          b.type === 'level' ? (
            <div class="level"><div class="thumb">image<br/>goes here</div><div class="lc"><h4>{b.name}</h4>{b.info && <p>{b.info}</p>}</div></div>
          ) : b.type === 'h' ? (
            <h4 class={b.level === 2 ? 'subhead subhead-lg' : 'subhead'}>{b.text}</h4>
          ) : b.type === 'list' ? (
            <ul class="bullets">{b.items.map((it) => (<li>{it.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</li>))}</ul>
          ) : (
            <p>{b.num && <span class="p-num">{b.num}</span>}{b.segments.map((s) => (s.term ? <span class="term" role="button" tabindex="0" data-cat={s.cat} data-term={s.term}>{s.t}</span> : <Fragment>{s.t}</Fragment>))}</p>
          )
        ))}
      </section>
    ))}
    <div class="footnote">Red = Ayurveda · Amber = Physiology · Olive = Anatomy. Tap any colored word to explore it; close to return to your place.</div>
  </div>

  <div class="scrim" id="scrim"></div>
  <aside class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-head">
      <button class="close-x" id="closeX" aria-label="Close and return">×</button>
      <span class="cat-pill" id="catPill">Term</span>
      <h3 id="dTitle">Term</h3>
      <div class="phon" id="dPhon"></div>
    </div>
    <div class="drawer-body" id="dBody"></div>
    <div class="back-hint">← Close to jump back exactly where you were reading.</div>
  </aside>

  <!-- Bottom pill navigation -->
  <nav class="toolbar" id="toolbar" aria-label="Reader tools">
    <div class="tbar-pill">
      <button class="tbar-btn" data-tool="darshan" title="The Six Philosophies" aria-label="The Six Philosophies">
        <img class="tbar-ic" src="/anim/philoIcon.svg" alt="" />
      </button>
      <button class="tbar-btn" data-tool="hero" title="Digestion map" aria-label="Digestion map">
        <img class="tbar-ic" src="/anim/intestineicon.svg" alt="" />
      </button>
      <button class="tbar-btn" data-tool="margas" title="Circulation map" aria-label="Circulation map">
        <img class="tbar-ic" src="/anim/magrasicon.svg" alt="" />
      </button>
      <button class="tbar-btn" data-tool="systems" title="Tri Dosha and body systems" aria-label="Tri Dosha and body systems">
        <img class="tbar-ic tbar-ic-sys" src="/anim/systemsicon.svg" alt="" onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22white%22 stroke-width=%221.7%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><path d=%22M12 3l9 5-9 5-9-5 9-5z%22/><path d=%22M3 13l9 5 9-5%22/></svg>'" />
      </button>
    </div>
    <div class="tbar-pill tbar-pill-gray">
      <button class="tbar-btn" data-tool="bookmark" title="Reading tools" aria-label="Reading tools">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.02A1.65 1.65 0 0 0 10 4.6V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.02c.14.6.63 1.06 1.24 1.19H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
      <button class="tbar-btn" data-tool="search" title="Search" aria-label="Search the book">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
      </button>
    </div>
  </nav>

  <div class="bm-menu" id="bmMenu" hidden>
    <button id="bmText">Text size: Normal</button>
    <button id="bmPlace">Place bookmark here</button>
    <button id="bmJump">Go to my bookmark</button>
    <button id="bmNotes">My notes</button>
  </div>

  <div class="darshan-modal" id="darshanModal" aria-hidden="true">
    <div class="darshan-win">
      <div class="dsh-head"><strong>Shad Darshan — The Six Philosophies of Life</strong><button class="close-x" id="darshanClose" aria-label="Close">×</button></div>
      <div class="dsh-body">
        <table class="dsh-table">
          <thead><tr><th>Philosophy</th><th>Founder</th></tr></thead>
          <tbody>
            <tr><td>Sānkhya</td><td>Kāpila</td></tr>
            <tr><td>Nyāya</td><td>Gautama</td></tr>
            <tr><td>Vaisheshika</td><td>Kanāda</td></tr>
            <tr><td>Mīmāmsa</td><td>Jaimini</td></tr>
            <tr><td>Yoga</td><td>Pātañjali</td></tr>
            <tr><td>Vedānta</td><td>Bādarāyana</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Hero modal -->
  <div class="hero-modal" id="heroModal" aria-hidden="true">
    <div class="hero-win">
      <div class="hm-head"><strong id="hmTitle">The Living Body - Digestion</strong><button class="close-x" id="heroClose" aria-label="Close">×</button></div>
      <div class="hm-body">
        <div class="hm-rail" id="hmRail" hidden></div>
      <div class="hero-stage">
        <video id="heroVideo" src="/anim/BodyAnimation_ready.mp4" playsinline preload="metadata"></video>
        <div class="hero-map" id="heroMap">
          <div class="map-viewport" id="mapViewport"><div class="map-canvas" id="mapCanvas"></div></div>
          <svg class="map-leader" id="mapLeader" hidden><line id="mcLine" x1="0" y1="0" x2="0" y2="0"/></svg>
          <div class="map-callout" id="mapCallout" hidden><button class="mc-close" id="mcClose" aria-label="Close">×</button><div class="mc-title" id="mcTitle"></div><div class="mc-body" id="mcBody"></div></div>
          <div class="map-list" id="mapList"><div class="map-list-title">Clickable organs — tap to jump</div><div class="map-chips" id="mapChips"></div></div>
          <div class="map-controls"><button id="mapTourBtn" title="Guided tour" style="display:none">Tour</button><button id="mapListBtn" title="List of clickable organs">Organs</button><button id="mapReset" title="Reset view">Reset view</button></div>
          <div class="map-tour" id="mapTour" hidden><button id="tourBack">‹ Back</button><span class="map-tour-count" id="tourCount"></span><button id="tourNext">Next ›</button><button id="tourExit" class="map-tour-exit">Exit</button></div>
          <div class="map-hint">Drag to pan · scroll or pinch to zoom · tap an organ</div>
        </div>
      </div>
        <aside class="hm-text" id="hmText" hidden></aside>
      </div>
      <div class="hm-bar">
        <button id="hmReplay">↻ Replay animation</button>
        <button id="hmExplore">Explore the map →</button>
      </div>
    </div>
  </div>

  <div class="simple-modal" id="simpleModal" aria-hidden="true">
    <div class="simple-win">
      <button class="close-x" id="simpleClose" aria-label="Close">×</button>
      <video class="simple-vid" id="simpleVid" controls playsinline preload="metadata"></video>
      <div class="simple-text" id="simpleText"></div>
    </div>
  </div>

  <!-- Search -->
  <div class="search-modal" id="searchModal" aria-hidden="true">
    <div class="search-win">
      <div class="search-head">
        <svg class="search-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
        <input type="search" id="searchInput" placeholder="Search terms and passages…" autocomplete="off" spellcheck="false" />
        <button class="close-x" id="searchClose" aria-label="Close">×</button>
      </div>
      <div class="search-results" id="searchResults"></div>
    </div>
  </div>

  <!-- Notebook -->
  <div class="notebook" id="notebook" aria-hidden="true">
    <div class="nb-head"><strong>My notes</strong><button class="close-x" id="nbClose" aria-label="Close">×</button></div>
    <textarea id="nbText" placeholder="Write your notes here… saved automatically on this device."></textarea>
    <div class="nb-bar">
      <button class="primary" id="nbShare">Share</button>
      <button id="nbClear" class="grow">Clear</button>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script id="glossary-data" type="application/json" set:html={JSON.stringify(glossary)} />
  <script id="icon-files" type="application/json" set:html={JSON.stringify(ICON_FILES)} />

  <script>
    const CATS = {
      ayurveda:   { label: 'Ayurveda',   color: 'var(--c-ayurveda)' },
      physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
      anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
    };
    const GLOSSARY = JSON.parse(document.getElementById('glossary-data').textContent);
    const ICON_FILES = JSON.parse((document.getElementById('icon-files') || {}).textContent || '[]');
    const ICON_MAP = {};
    ICON_FILES.forEach((f) => { const n = f.replace(/\.(svg|png)$/i, '').toLowerCase().replace(/[-_\s]+/g, ' ').trim(); if (!(n in ICON_MAP)) ICON_MAP[n] = f; });
    window.iconHTML = function (key) {
      const n = (key || '').toLowerCase().replace(/[-_\s]+/g, ' ').trim();
      const f = ICON_MAP[n];
      if (!f) return '';
      const wide = /avastha paka$/.test(n);
      return '<img class="def-icon' + (wide ? ' def-icon-wide' : '') + '" src="/anim/icons/' + encodeURIComponent(f) + '" alt="">';
    };
    let CONNECTIONS = null;
    function relFold(s) { return (s || '').normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
    function buildConnections() {
      const keys = Object.keys(GLOSSARY);
      const entries = keys.map((k) => ({ k, t: relFold(GLOSSARY[k].title || k) })).filter((e) => e.t.length > 2).sort((a, b) => b.t.length - a.t.length);
      const titleToKey = {}; entries.forEach((e) => { if (!(e.t in titleToKey)) titleToKey[e.t] = e.k; });
      const alt = entries.map((e) => e.t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
      const re = new RegExp('\\b(' + alt + ')\\b', 'g');
      const out = {}; keys.forEach((k) => out[k] = new Set());
      keys.forEach((k) => { const body = relFold((GLOSSARY[k].body || '').replace(/<[^>]+>/g, ' ')); let m; re.lastIndex = 0; while ((m = re.exec(body))) { const o = titleToKey[m[1]]; if (o && o !== k) { out[k].add(o); out[o].add(k); } } });
      CONNECTIONS = out;
    }
    function relatedHTML(key, exclDoshas) {
      if (!CONNECTIONS) buildConnections();
      let rel = [...(CONNECTIONS[key] || [])];
      if (exclDoshas) rel = rel.filter((k) => k !== 'vata dosha' && k !== 'pitta dosha' && k !== 'kapha dosha');
      if (!rel.length) return '';
      rel = rel.map((k) => ({ k, title: GLOSSARY[k].title || k, cat: GLOSSARY[k].cat })).sort((a, b) => a.title.localeCompare(b.title)).slice(0, 18);
      const chips = rel.map((r) => '<button class="rel-chip" data-term="' + r.k.replace(/"/g, '&quot;') + '"><i class="rel-dot" style="background:' + ((CATS[r.cat] && CATS[r.cat].color) || 'var(--ink)') + '"></i>' + r.title + '</button>').join('');
      return '<div class="rel-explore"><div class="rel-label">Connected terms</div><div class="rel-chips">' + chips + '</div></div>';
    }
    const DOSHAS = [
      { key: 'vata dosha', label: 'Vata', emoji: '💨', slug: 'vata-dosha' },
      { key: 'pitta dosha', label: 'Pitta', emoji: '🔥', slug: 'pitta-dosha' },
      { key: 'kapha dosha', label: 'Kapha', emoji: '🌊', slug: 'kapha-dosha' },
    ];
    function doshaFor(g) {
      const t = ((g.title || '') + ' ' + (g.body || '')).normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase();
      const hits = [];
      if (/\bvata\b/.test(t)) hits.push('vata dosha');
      if (/\bpitta\b/.test(t)) hits.push('pitta dosha');
      if (/\bkapha\b/.test(t)) hits.push('kapha dosha');
      return hits.length === 1 ? hits[0] : null;
    }
    function doshaExploreHTML(cur) {
      const cards = DOSHAS.map((d) => '<button class="de-card' + (d.key === cur ? ' is-on' : '') + '" data-term="' + d.key + '"><span class="de-ic"><img class="de-img" src="/anim/icons/' + d.slug + '.svg" alt="" data-emoji="' + d.emoji + '"></span><span class="de-lbl">' + d.label + '</span></button>').join('');
      return '<div class="dosha-explore"><div class="de-label">Explore the doshas</div><div class="de-cards">' + cards + '</div></div>';
    }
    const scrim = document.getElementById('scrim');
    const drawer = document.getElementById('drawer');
    const catPill = document.getElementById('catPill');
    const dTitle = document.getElementById('dTitle');
    const dPhon = document.getElementById('dPhon');
    const dBody = document.getElementById('dBody');
    const attachScrollHint = function (scrollEl, host) {
      const hint = document.createElement('div');
      hint.className = 'scroll-hint'; hint.innerHTML = 'Scroll <span class="sh-arrow">\u2193</span>';
      host.appendChild(hint);
      const upd = () => {
        const more = scrollEl.scrollHeight - scrollEl.clientHeight - scrollEl.scrollTop > 14;
        if (more) { const r = scrollEl.getBoundingClientRect(), hr = host.getBoundingClientRect(); hint.style.bottom = Math.max(6, hr.bottom - r.bottom + 8) + 'px'; }
        hint.classList.toggle('show', more);
      };
      scrollEl.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd);
      return upd;
    };
    const drawerHint = attachScrollHint(dBody, drawer);
    let savedY = 0;
    function openTerm(key) {
      const g = GLOSSARY[key];
      if (!g) return;
      savedY = window.scrollY;
      const cat = CATS[g.cat] || { label: 'Term', color: 'var(--ink)' };
      catPill.textContent = cat.label; catPill.style.background = cat.color;
      dTitle.textContent = g.title; dTitle.style.color = cat.color;
      dPhon.textContent = g.phon || '';
      dBody.innerHTML = window.iconHTML(key) + (g.body || '<p><em>Definition coming soon.</em></p>');
      const _dk = doshaFor(g);
      if (_dk) {
        dBody.insertAdjacentHTML('beforeend', doshaExploreHTML(_dk));
        dBody.querySelectorAll('.de-card').forEach((c) => {
          c.addEventListener('click', () => openTerm(c.dataset.term));
          const im = c.querySelector('img'); if (im) im.addEventListener('error', () => { const sp = document.createElement('span'); sp.className = 'de-emoji'; sp.textContent = im.dataset.emoji; im.replaceWith(sp); });
        });
      }
      const _rel = relatedHTML(key, !!_dk);
      if (_rel) { dBody.insertAdjacentHTML('beforeend', _rel); dBody.querySelectorAll('.rel-chip').forEach((c) => c.addEventListener('click', () => openTerm(c.dataset.term))); }
      dBody.scrollTop = 0; requestAnimationFrame(drawerHint);
      scrim.classList.add('open'); drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      history.pushState({ term: key }, '');
    }
    function closeTerm(push) {
      scrim.classList.remove('open'); drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      window.scrollTo({ top: savedY });
      if (push && history.state && history.state.term) history.back();
    }
    document.querySelectorAll('.term').forEach((b) => {
      b.addEventListener('click', () => openTerm(b.dataset.term));
      b.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openTerm(b.dataset.term); } });
    });
    document.getElementById('closeX').addEventListener('click', () => closeTerm(true));
    scrim.addEventListener('click', () => closeTerm(true));
    window.addEventListener('popstate', () => closeTerm(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTerm(true); });
    // expose for the hero map to open organ definitions
    window.openGlossary = openTerm;
    // ---------- Search ----------
    const searchModal = document.getElementById('searchModal');
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    let searchIndex = null;
    function buildSearchIndex() {
      const idx = [];
      document.querySelectorAll('.wrap section').forEach((sec) => {
        const chap = (sec.querySelector('h2.chapter') || {}).textContent || '';
        const title = (sec.querySelector('h3') || {}).textContent || '';
        sec.querySelectorAll('p, li, h4.subhead').forEach((el) => {
          const text = (el.textContent || '').trim();
          if (text.length > 2) idx.push({ el: el, text: text, label: (chap.trim() + ' · ' + title.trim()).replace(/^ · | · $/, '') });
        });
      });
      return idx;
    }
    function escHtml(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
    function snippet(text, q) {
      const i = text.toLowerCase().indexOf(q);
      if (i < 0) return escHtml(text.slice(0, 140));
      const a = Math.max(0, i - 55), b = Math.min(text.length, i + q.length + 95);
      return (a > 0 ? '…' : '') + escHtml(text.slice(a, i)) + '<mark>' + escHtml(text.slice(i, i + q.length)) + '</mark>' + escHtml(text.slice(i + q.length, b)) + (b < text.length ? '…' : '');
    }
    function runSearch() {
      const raw = searchInput.value.trim(), q = raw.toLowerCase();
      if (q.length < 2) { searchResults.innerHTML = '<div class="sr-hint">Type at least two letters to search.</div>'; return; }
      if (!searchIndex) searchIndex = buildSearchIndex();
      let html = '';
      const terms = [];
      for (const k in GLOSSARY) {
        const g = GLOSSARY[k];
        const t = (g.title || '').toLowerCase();
        const body = (g.body || '').replace(/<[^>]+>/g, ' ').toLowerCase();
        if (t.includes(q) || body.includes(q)) terms.push([k, g, t.startsWith(q) ? 0 : (t.includes(q) ? 1 : 2)]);
      }
      terms.sort((a, b) => a[2] - b[2] || a[1].title.localeCompare(b[1].title));
      if (terms.length) {
        html += '<div class="sr-group">Definitions</div>';
        terms.slice(0, 10).forEach(([k, g]) => {
          const col = (CATS[g.cat] || {}).color || 'var(--ink)';
          html += '<button class="sr-item" data-term="' + escHtml(k) + '"><span class="sr-dot" style="background:' + col + '"></span><span class="sr-title">' + escHtml(g.title) + '</span></button>';
        });
      }
      const hits = [];
      searchIndex.forEach((e, n) => { if (e.text.toLowerCase().includes(q)) hits.push(n); });
      if (hits.length) {
        html += '<div class="sr-group">In the book · ' + hits.length + '</div>';
        hits.slice(0, 25).forEach((n) => {
          const e = searchIndex[n];
          html += '<button class="sr-item sr-pass" data-i="' + n + '"><span class="sr-ch">' + escHtml(e.label) + '</span><span class="sr-snip">' + snippet(e.text, q) + '</span></button>';
        });
      }
      searchResults.innerHTML = html || '<div class="sr-hint">No matches for “' + escHtml(raw) + '”.</div>';
    }
    function openSearch() { searchModal.classList.add('open'); searchModal.setAttribute('aria-hidden', 'false'); searchInput.focus(); searchInput.select(); if (!searchInput.value) runSearch(); }
    function closeSearch() { searchModal.classList.remove('open'); searchModal.setAttribute('aria-hidden', 'true'); }
    searchInput.addEventListener('input', runSearch);
    document.getElementById('searchClose').addEventListener('click', closeSearch);
    searchModal.addEventListener('click', (e) => { if (e.target === searchModal) closeSearch(); });
    searchResults.addEventListener('click', (e) => {
      const btn = e.target.closest('.sr-item'); if (!btn) return;
      if (btn.dataset.term) { closeSearch(); openTerm(btn.dataset.term); return; }
      const n = parseInt(btn.dataset.i, 10);
      const entry = searchIndex && searchIndex[n];
      if (entry && entry.el) {
        closeSearch();
        entry.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        entry.el.classList.add('search-flash');
        setTimeout(() => entry.el.classList.remove('search-flash'), 1800);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchModal.classList.contains('open')) closeSearch();
      if ((e.key === 'f' || e.key === 'F') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); openSearch(); }
    });
    document.querySelectorAll('[data-tool="search"]').forEach((b) => b.addEventListener('click', openSearch));


    // ---------- Intro video play button ----------
    (function () {
      const v = document.getElementById('introVid');
      const btn = document.getElementById('introPlay');
      if (!v || !btn) return;
      const pauseBtn = document.getElementById('introPause');
      let lock = 0;
      btn.addEventListener('click', (e) => { e.stopPropagation(); lock = Date.now(); v.play().catch(() => {}); });
      if (pauseBtn) pauseBtn.addEventListener('click', (e) => { e.stopPropagation(); if (Date.now() - lock < 350) return; v.pause(); });
      v.addEventListener('click', () => { if (Date.now() - lock < 350) return; if (v.paused) v.play().catch(() => {}); else v.pause(); });
      v.addEventListener('play', () => v.parentElement.classList.add('playing'));
      v.addEventListener('pause', () => v.parentElement.classList.remove('playing'));
      v.addEventListener('ended', () => { v.parentElement.classList.remove('playing'); });
    })();
  </script>

  <script>
    // Levels-of-Organization scroll scene (Lottie)
    import lottie from 'lottie-web';
    const scene = document.querySelector('.lo-scene');
    if (scene && !document.documentElement.classList.contains('skip-intro')) {
      const stages = [...scene.querySelectorAll('.lo-stage')];
      const steps = [...scene.querySelectorAll('.lo-step')];
      const dotsWrap = document.getElementById('loDots');
      let active = 0;
      const players = stages.map((st) => {
        const lot = st.querySelector('[data-lottie]');
        if (lot) return { type: 'lottie', anim: lottie.loadAnimation({ container: lot, renderer: 'svg', loop: false, autoplay: false, path: lot.dataset.lottie }) };
        const vid = st.querySelector('video[data-video]');
        if (vid) { vid.muted = true; return { type: 'video', el: vid }; }
        return null;
      });
      function playMedia(i) {
        players.forEach((p, n) => {
          if (!p) return;
          if (n === i) { if (p.type === 'lottie') p.anim.goToAndPlay(0, true); else { try { p.el.currentTime = 0; } catch (e) {} p.el.play().catch(() => {}); } }
          else { if (p.type === 'lottie') p.anim.pause(); else p.el.pause(); }
        });
      }
      const dots = stages.map((_, i) => {
        const d = document.createElement('button');
        d.className = 'lo-dot' + (i === 0 ? ' is-on' : '');
        d.setAttribute('aria-label', 'Go to stage ' + (i + 1));
        d.addEventListener('click', () => steps[i].scrollIntoView({ behavior: 'smooth', block: 'center' }));
        dotsWrap.appendChild(d);
        return d;
      });
      function show(i, force) {
        if (i === active && !force) return;
        if (force) { stages[i].classList.remove('is-active'); void stages[i].offsetWidth; }
        stages.forEach((s, n) => s.classList.toggle('is-active', n === i));
        dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
        active = i; playMedia(i);
        if (i === stages.length - 1) { try { localStorage.setItem('seenIntro', '1'); } catch (e) {} }
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) show(+e.target.dataset.step, false); });
      }, { rootMargin: '-50% 0px -50% 0px' });
      steps.forEach((s) => io.observe(s));
      stages[0].classList.add('is-active');
      playMedia(0);
    }
  </script>

  <script>
    // Toolbox + hero modal + notebook + bookmark
    const T = document.getElementById('toast');
    function toast(msg) { T.textContent = msg; T.classList.add('show'); clearTimeout(T._t); T._t = setTimeout(() => T.classList.remove('show'), 1900); }
    const FS_STEPS = ['', 'fs-m', 'fs-l'], FS_LABELS = ['Normal', 'Large', 'Larger'];
    function applyFS(c) { const d = document.documentElement; d.classList.remove('fs-m', 'fs-l'); if (c) d.classList.add(c); try { localStorage.setItem('tlb-fontsize', c); } catch (e) {} }
