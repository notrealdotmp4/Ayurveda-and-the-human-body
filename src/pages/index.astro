      const vr = mapViewport.getBoundingClientRect(), or = el.getBoundingClientRect();
      const cx = or.left + or.width / 2 - vr.left, cy = or.top + or.height / 2 - vr.top;
      const ocx = (cx - mTx) / mScale, ocy = (cy - mTy) / mScale;
      mScale = Math.min(6, Math.max(1, 2.2));
      mTx = vr.width / 2 - mScale * ocx; mTy = vr.height / 2 - mScale * ocy;
      mApply();
    }
    function buildOrganList(organMap) {
      const entries = [...organMap.entries()].map(([key, el]) => ({ key, el, title: (MAP_GLOSSARY[key] && MAP_GLOSSARY[key].title) || key }))
        .sort((a, b) => a.title.localeCompare(b.title));
      if (heroKind === 'digestion') {
        // Agni popup: left rail is the 40-Agni accordion (built in openHero), not the organ list.
        if (mapListBtn) mapListBtn.style.display = 'none';
        return;
      }
      const chips = document.getElementById('mapChips'); if (!chips) return; chips.innerHTML = '';
      entries.forEach(({ key, el, title }) => {
        const b = document.createElement('button'); b.className = 'map-chip'; b.textContent = title;
        b.addEventListener('click', () => { mapList.classList.remove('show'); focusOrgan(el); showCallout(el, key); });
        chips.appendChild(b);
      });
      if (mapListBtn) mapListBtn.style.display = (heroKind === 'systems' && chips.children.length) ? '' : 'none';
    }
    mapViewport.addEventListener('wheel', (e) => { e.preventDefault(); const r = mapViewport.getBoundingClientRect(); const cx = e.clientX - r.left, cy = e.clientY - r.top; const f = e.deltaY < 0 ? 1.12 : 1 / 1.12; const ns = Math.min(6, Math.max(1, mScale * f)); const k = ns / mScale; mTx = cx - k * (cx - mTx); mTy = cy - k * (cy - mTy); mScale = ns; mApply(); }, { passive: false });
    let mGestureStart = 1;
    mapViewport.addEventListener('gesturestart', (e) => { e.preventDefault(); mGestureStart = mScale; });
    mapViewport.addEventListener('gesturechange', (e) => { e.preventDefault(); const r = mapViewport.getBoundingClientRect(); const cx = ((e.clientX != null ? e.clientX : r.left + r.width / 2)) - r.left, cy = ((e.clientY != null ? e.clientY : r.top + r.height / 2)) - r.top; const ns = Math.min(6, Math.max(1, mGestureStart * e.scale)); const k = ns / mScale; mTx = cx - k * (cx - mTx); mTy = cy - k * (cy - mTy); mScale = ns; mApply(); });
    mapViewport.addEventListener('gestureend', (e) => { e.preventDefault(); });
    const mPts = new Map(); let mLast = null, mStartD = 0, mStartS = 1;
    function mMove(e) { if (!mPts.has(e.pointerId)) return; mPts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (mPts.size === 2) { const [a, b] = [...mPts.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y); const r = mapViewport.getBoundingClientRect(); const cx = (a.x + b.x) / 2 - r.left, cy = (a.y + b.y) / 2 - r.top; const ns = Math.min(6, Math.max(1, mStartS * (d / (mStartD || d)))); const k = ns / mScale; mTx = cx - k * (cx - mTx); mTy = cy - k * (cy - mTy); mScale = ns; mDragged = true; mApply(); }
      else if (mPts.size === 1 && mLast) { const dx = e.clientX - mLast.x, dy = e.clientY - mLast.y; mTx += dx; mTy += dy; mLast = { x: e.clientX, y: e.clientY }; if (Math.abs(dx) + Math.abs(dy) > 4) mDragged = true; mApply(); } }
    function mUp(e) { if (!mPts.has(e.pointerId)) return; mPts.delete(e.pointerId); if (mPts.size < 2) mStartD = 0; if (mPts.size === 1) { const p = [...mPts.values()][0]; mLast = { x: p.x, y: p.y }; } else { mLast = null; window.removeEventListener('pointermove', mMove); window.removeEventListener('pointerup', mUp); window.removeEventListener('pointercancel', mUp); } }
    mapViewport.addEventListener('pointerdown', (e) => { mPts.set(e.pointerId, { x: e.clientX, y: e.clientY }); mDragged = false; if (mPts.size === 1) { mLast = { x: e.clientX, y: e.clientY }; window.addEventListener('pointermove', mMove); window.addEventListener('pointerup', mUp); window.addEventListener('pointercancel', mUp); } else if (mPts.size === 2) { const [a, b] = [...mPts.values()]; mStartD = Math.hypot(a.x - b.x, a.y - b.y); mStartS = mScale; } });
    mapViewport.addEventListener('click', () => { if (!mDragged) hideCallout(); });
    document.getElementById('mcClose').addEventListener('click', hideCallout);
    document.getElementById('mapReset').addEventListener('click', () => { mReset(); hideCallout(); });
    { const ms = document.getElementById('mapSex'); if (ms) ms.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => setSysSex(b.dataset.sex))); }
    const mapListBtn = document.getElementById('mapListBtn');
    if (mapListBtn) mapListBtn.addEventListener('click', () => mapList.classList.toggle('show'));
    let mapOrgansByKey = null, tourStops = [], tourI = -1;
    const TOUR = {};
    const mapTour = document.getElementById('mapTour');
    const tourCount = document.getElementById('tourCount');
    function tourGo(i) {
      if (i < 0 || i >= tourStops.length) return;
      const key = tourStops[i];
      if (key === '__reset__') { mReset(); hideCallout(); mapTour.hidden = true; tourI = -1; return; }
      tourI = i;
      const el = mapOrgansByKey && mapOrgansByKey.get(key);
      if (el) { focusOrgan(el); showCallout(el, key); }
      const total = tourStops.filter((k) => k !== '__reset__').length;
      tourCount.textContent = (i + 1) + ' / ' + total;
      document.getElementById('tourBack').disabled = (i === 0);
      document.getElementById('tourNext').disabled = false;
    }
    function startTour() {
      tourStops = (TOUR[currentMapSrc] || []).filter((k) => k === '__reset__' || (mapOrgansByKey && mapOrgansByKey.has(k)));
      if (!tourStops.filter((k) => k !== '__reset__').length) return;
      if (mapList) mapList.classList.remove('show'); mapTour.hidden = false; tourGo(0);
    }
    function endTour() { mapTour.hidden = true; hideCallout(); }
    { const tb = document.getElementById('mapTourBtn'); if (tb) tb.addEventListener('click', startTour); }
    document.getElementById('tourNext').addEventListener('click', () => tourGo(tourI + 1));
    document.getElementById('tourBack').addEventListener('click', () => tourGo(tourI - 1));
    document.getElementById('tourExit').addEventListener('click', endTour);

    function animateVessels() {
      { const heart = mapCanvas.querySelector('#heart, [id^="heart"], [id^="Heart"]'); if (heart) heart.classList.add('heart-anim'); }
      const groups = mapCanvas.querySelectorAll('#Artery, #Vein, [id^="Artery"], [id^="Vein"]');
      if (!groups.length) return;
      const svgEl = mapCanvas.querySelector('svg');
      const vbH = (svgEl && svgEl.viewBox && svgEl.viewBox.baseVal && svgEl.viewBox.baseVal.height) || 1000;
      const CYCLE = 2.6;
      groups.forEach((g) => {
        const isVein = /vein/i.test(g.id);
        g.querySelectorAll('path').forEach((p) => {
          let yNorm = 0;
          try { const b = p.getBBox(); yNorm = Math.min(1, Math.max(0, (b.y + b.height / 2) / vbH)); } catch (e) {}
          const phase = isVein ? (1 - yNorm) : yNorm;
          p.classList.add('vessel-anim');
          p.style.animationDelay = (-(phase * CYCLE)).toFixed(2) + 's';
        });
      });
    }
    const MAP_CACHE = {}; let loadSeq = 0;
    const MAP_PLACEHOLDER = '<p style="font-family:system-ui,sans-serif;color:var(--ink-soft);text-align:center;max-width:30ch;margin:auto;padding:20px">Interactive map coming soon — drop the SVG into /public/anim.</p>';
    const MAP_LOADING = '<div style="display:flex;align-items:center;justify-content:center;height:100%;min-height:180px"><div class="map-spinner" aria-label="Loading map"></div></div>';
    function loadMap() {
      const src = heroMapSrc || '/anim/digestive-map.svg';
      if (currentMapSrc === src) { mReset(); if (mapOrgansByKey) buildOrganList(mapOrgansByKey); return; }
      currentMapSrc = src; hideCallout(); if (mapList) mapList.classList.remove('show');
      const myid = ++loadSeq;
      const render = (svg) => {
        if (myid !== loadSeq || currentMapSrc !== src) return; // a newer map won the race
        const _low = svg.slice(0, 500).toLowerCase();
        if (svg.indexOf('<svg') === -1 || _low.indexOf('<!doctype') !== -1 || _low.indexOf('<html') !== -1) { mapCanvas.innerHTML = MAP_PLACEHOLDER; return; }
        mapCanvas.innerHTML = svg;
        const svgEl = mapCanvas.querySelector('svg'); if (svgEl) { svgEl.setAttribute('preserveAspectRatio', 'xMidYMid meet'); svgEl.setAttribute('width', '100%'); svgEl.setAttribute('height', '100%'); }
        const organMap = new Map();
        mapCanvas.querySelectorAll('[data-term],[id]').forEach((el) => {
          const raw = el.getAttribute('data-term') || el.id; if (!raw) return;
          let key = raw.toLowerCase().replace(/[_-]+/g, ' ').trim();
          if (!MAP_GLOSSARY[key] && MAP_ALIAS[key]) key = MAP_ALIAS[key];
          if (!MAP_GLOSSARY[key]) return;
          const k = key;
          el.style.cursor = 'pointer'; el.classList.add('map-organ');
          el.addEventListener('click', (ev) => { ev.stopPropagation(); if (mDragged) return; showCallout(el, k); });
          if (!organMap.has(k)) organMap.set(k, el);
        });
        buildOrganList(organMap); mapOrgansByKey = organMap; { const _tb = document.getElementById('mapTourBtn'); if (_tb) _tb.style.display = TOUR[src] ? '' : 'none'; } mapTour.hidden = true; if (mapList) mapList.classList.remove('show'); { const _rp = document.getElementById('mapReplay'); if (_rp) _rp.style.display = (heroKind === 'digestion') ? '' : 'none'; }
        animateVessels();
        mReset();
      };
      if (MAP_CACHE[src]) { render(MAP_CACHE[src]); return; }
      mapCanvas.innerHTML = MAP_LOADING; // clear the previous map so it isn't shown under the new title while fetching
      fetch(src).then((r) => r.ok ? r.text() : Promise.reject()).then((svg) => { MAP_CACHE[src] = svg; render(svg); }).catch(() => {
        const baseSrc = src.replace(/-(female|male)\.svg$/, '.svg');
        if (baseSrc !== src) { currentMapSrc = null; heroMapSrc = baseSrc; loadMap(); return; } // sexed file missing -> fall back to base
        if (myid === loadSeq) mapCanvas.innerHTML = MAP_PLACEHOLDER;
      });
    }
    document.getElementById('heroClose').addEventListener('click', closeHero);
    { const _mc = document.getElementById('mapCta'); if (_mc) _mc.addEventListener('click', openHero); }
    { const _mc2 = document.getElementById('mapCta2'); if (_mc2) _mc2.addEventListener('click', openVyadhi); }
    { const _mcs = document.getElementById('mapCtaSys'); if (_mcs) _mcs.addEventListener('click', openSystems); }
    { const _rp = document.getElementById('mapReplay'); if (_rp) _rp.addEventListener('click', showVideo); }
    heroVideo.addEventListener('ended', showMap);

    // Notebook
    const notebook = document.getElementById('notebook');
    const nbText = document.getElementById('nbText');
    const NB_KEY = 'tlb-notes';
    try { nbText.value = localStorage.getItem(NB_KEY) || ''; } catch (e) {}
    nbText.addEventListener('input', () => { try { localStorage.setItem(NB_KEY, nbText.value); } catch (e) {} });
    function openNotebook() { notebook.classList.add('open'); notebook.setAttribute('aria-hidden', 'false'); nbText.focus(); }
    document.getElementById('nbClose').addEventListener('click', () => notebook.classList.remove('open'));
    document.getElementById('nbClear').addEventListener('click', () => { if (confirm('Clear all notes?')) { nbText.value = ''; try { localStorage.removeItem(NB_KEY); } catch (e) {} } });
    document.getElementById('nbShare').addEventListener('click', async () => {
      const text = (nbText.value || '').trim();
      if (!text) { toast('Write a note first'); return; }
      const body = text + '\n\n— my notes from The Living Body\n' + location.href;
      const payload = { title: 'My notes — The Living Body', text: body };
      if (navigator.share) { try { await navigator.share(payload); } catch (e) {} }
      else {
        try { await navigator.clipboard.writeText(body); toast('Copied — paste it anywhere'); }
        catch (e) { window.location.href = 'mailto:?subject=' + encodeURIComponent(payload.title) + '&body=' + encodeURIComponent(body); }
      }
    });

    // Bookmark
    const BM_KEY = 'tlb-bookmark';
    function placeBookmark() { try { localStorage.setItem(BM_KEY, String(Math.round(window.scrollY))); toast('Bookmark placed'); } catch (e) {} }
    function jumpBookmark() { let y = null; try { y = localStorage.getItem(BM_KEY); } catch (e) {} if (y === null) { toast('No bookmark yet'); return; } window.scrollTo({ top: +y, behavior: 'smooth' }); }

    toolbar.querySelectorAll('[data-tool]').forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.tool;
      if (t === 'hero') openHero();
      else if (t === 'bookmark') toggleBmMenu();
      else if (t === 'darshan') openDarshan();
      else if (t === 'margas') openVyadhi();
      else if (t === 'systems') openSystems();
    }));
    const bmMenu = document.getElementById('bmMenu');
    const bmText = document.getElementById('bmText');
    function fsCurLabel() { let cur=''; try { cur = localStorage.getItem('tlb-fontsize') || ''; } catch (e) {} const i = FS_STEPS.indexOf(cur); return 'Text size: ' + FS_LABELS[i < 0 ? 0 : i]; }
    if (bmText) { bmText.textContent = fsCurLabel(); bmText.addEventListener('click', (e) => { e.stopPropagation(); cycleFontSize(); bmText.textContent = fsCurLabel(); }); }
    function toggleBmMenu() {
      const show = bmMenu.hidden; bmMenu.hidden = !show;
      if (show) { const btn = document.querySelector('[data-tool="bookmark"]'); const pill = (btn && btn.closest('.tbar-pill')) || btn; if (pill) { const r = pill.getBoundingClientRect(); bmMenu.style.left = (r.left + r.width / 2) + 'px'; } }
    }
    document.getElementById('bmPlace').addEventListener('click', () => { placeBookmark(); bmMenu.hidden = true; });
    document.getElementById('bmJump').addEventListener('click', () => { jumpBookmark(); bmMenu.hidden = true; });
    document.getElementById('bmNotes').addEventListener('click', () => { openNotebook(); bmMenu.hidden = true; });
    document.addEventListener('click', (e) => { if (!bmMenu.hidden && !bmMenu.contains(e.target) && !(e.target.closest && e.target.closest('[data-tool=\"bookmark\"]'))) bmMenu.hidden = true; });
    const darshanModal = document.getElementById('darshanModal');
    const darshanHint = attachScrollHint(darshanModal.querySelector('.dsh-body'), darshanModal.querySelector('.darshan-win'));
    function openDarshan() { darshanModal.classList.add('open'); darshanModal.setAttribute('aria-hidden', 'false'); requestAnimationFrame(darshanHint); }
    function closeDarshan() { darshanModal.classList.remove('open'); darshanModal.setAttribute('aria-hidden', 'true'); }
    document.getElementById('darshanClose').addEventListener('click', closeDarshan);
    { const _pb = document.getElementById('philBtn'); if (_pb) _pb.addEventListener('click', openDarshan); }
    darshanModal.addEventListener('click', (e) => { if (e.target === darshanModal) closeDarshan(); });
    const loRevisit = document.getElementById('loRevisit');
    if (loRevisit) loRevisit.addEventListener('click', () => { try { localStorage.removeItem('seenIntro'); } catch (e) {} document.documentElement.classList.remove('skip-intro'); window.scrollTo({ top: 0 }); location.reload(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeHero(); notebook.classList.remove('open'); } });
    document.querySelectorAll('.stage-toggle').forEach((btn) => {
      const panel = btn.nextElementSibling;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (panel) panel.hidden = open;
      });
    });
    document.querySelectorAll('.sr-group').forEach((btn) => {
      const g = btn.dataset.group;
      const setState = (collapsed) => {
        btn.classList.toggle('collapsed', collapsed);
        btn.setAttribute('aria-expanded', String(!collapsed));
        document.querySelectorAll('[data-grp="' + g + '"]').forEach((c) => { c.style.display = collapsed ? 'none' : ''; });
      };
      setState(true); // start collapsed
      btn.addEventListener('click', () => setState(!btn.classList.contains('collapsed')));
    });
    // Samprāpti table: make quality/term cells open their glossary definition in the sidebar.
    (function () {
      const GL = JSON.parse(document.getElementById('glossary-data').textContent);
      const normG = (s) => s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^\w\s]/g, ' ').replace(/\s+/g, ' ').trim();
      const linkify = (text) => {
        const parts = text.split(/(\s*[\/,&]\s*)/);
        let html = '';
        parts.forEach((p, i) => {
          const esc = p.replace(/&/g, '&amp;').replace(/</g, '&lt;');
          if (i % 2 === 1) { html += esc; return; }
          const key = normG(p);
          if (p.trim() && GL[key]) { html += '<span class="sam-link" data-term="' + key + '">' + esc + '</span>'; }
          else html += esc;
        });
        return html;
      };
      const samGrid = document.querySelector('.sam-grid');
      // Wrap every table cell's content in a plain (non-grid-item) inner element so
      // `display:table-cell; vertical-align:middle` actually centers it — a direct
      // CSS Grid item can't use table-cell vertical-align (browsers force it to block).
      document.querySelectorAll('.sam-cell').forEach((el) => {
        if (el.classList.contains('sam-doshalbl')) return; // handled separately below
        const shouldLink = samGrid && samGrid.contains(el) && el.matches('.sam-val, .sam-proc, .sam-marga-cell');
        const inner = document.createElement('span');
        inner.className = 'cell-inner';
        inner.innerHTML = shouldLink ? linkify(el.textContent) : el.innerHTML;
        el.replaceChildren(inner);
      });
      document.querySelectorAll('.sam-doshalbl span').forEach((span) => {
        span.innerHTML = linkify(span.textContent);
      });
      document.addEventListener('click', (e) => { const t = e.target.closest('.sam-link'); if (t && window.openGlossary) window.openGlossary(t.dataset.term); });
    })();
  </script>
</body>
</html>
