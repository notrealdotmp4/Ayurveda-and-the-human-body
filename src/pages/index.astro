---
import content from '../data/content.json';
import glossary from '../data/glossary.json';
import '../styles/book.css';

const CATS = {
  ayurveda:   { label: 'Ayurveda',   color: 'var(--c-ayurveda)' },
  physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
  anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
};

// Placeholder SVGs for the levels-of-organization stages.
// Swap any of these for a Lottie container later (see the <div class="lo-art"> slot).
const ART = [
  `<svg viewBox="0 0 120 120" fill="none"><g stroke="var(--c-physiology)" stroke-width="2"><ellipse cx="60" cy="60" rx="46" ry="17"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(60 60 60)"/><ellipse cx="60" cy="60" rx="46" ry="17" transform="rotate(120 60 60)"/></g><circle cx="60" cy="60" r="9" fill="var(--ink)"/><circle cx="106" cy="60" r="4" fill="var(--c-physiology)"/><circle cx="37" cy="33" r="3.5" fill="var(--c-physiology)"/></svg>`,
  `<svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="44" fill="#f6efe3" stroke="var(--c-physiology)" stroke-width="2"/><circle cx="60" cy="60" r="16" fill="var(--ink)" opacity=".85"/><circle cx="40" cy="44" r="5" fill="var(--c-physiology)"/><circle cx="82" cy="72" r="6" fill="var(--c-physiology)"/><circle cx="74" cy="40" r="3" fill="var(--c-physiology)"/></svg>`,
  `<svg viewBox="0 0 120 120"><g fill="#f6efe3" stroke="var(--c-physiology)" stroke-width="2"><circle cx="44" cy="46" r="18"/><circle cx="74" cy="44" r="18"/><circle cx="58" cy="72" r="18"/><circle cx="86" cy="74" r="15"/><circle cx="34" cy="74" r="14"/></g><g fill="var(--ink)" opacity=".8"><circle cx="44" cy="46" r="5"/><circle cx="74" cy="44" r="5"/><circle cx="58" cy="72" r="5"/><circle cx="86" cy="74" r="4"/><circle cx="34" cy="74" r="4"/></g></svg>`,
  `<svg viewBox="0 0 120 120"><path d="M40 28 C70 18 96 34 92 60 C88 86 64 100 46 92 C28 84 22 60 30 46 C34 38 34 32 40 28 Z" fill="#f6efe3" stroke="var(--c-anatomy)" stroke-width="2.5"/><path d="M52 44 C64 40 76 48 74 60" stroke="var(--c-anatomy)" stroke-width="2" fill="none"/></svg>`,
  `<svg viewBox="0 0 120 120"><circle cx="60" cy="24" r="10" fill="none" stroke="var(--ink)" stroke-width="2.5"/><path d="M60 34 L60 86 M60 50 L40 70 M60 50 L80 70 M60 86 L46 108 M60 86 L74 108" stroke="var(--ink)" stroke-width="2.5" fill="none" stroke-linecap="round"/><path d="M60 40 C50 48 70 56 60 66 C50 74 68 80 60 86" stroke="var(--c-anatomy)" stroke-width="2.5" fill="none"/></svg>`,
];

const chapters = content.chapters;
const first = chapters[0];
const isLO = !!(first && first.blocks.some((b) => b.type === 'level'));
const loStages  = isLO ? first.blocks.filter((b) => b.type === 'level' && b.info) : [];
const loOrganism = isLO ? first.blocks.find((b) => b.type === 'level' && !b.info) : null;
const loClosing = isLO ? first.blocks.filter((b) => b.type === 'p') : [];
const rest = isLO ? chapters.slice(1) : chapters;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{content.title} — An Interactive Ayurveda Book</title>
</head>
<body>
  {isLO && (
    <section class="lo">
      <div class="lo-intro">
        {content.invocation && <div class="invocation">{content.invocation}</div>}
        <div class="lo-intro-art">image goes here</div>
        <div class="lo-kicker">{first.kicker}</div>
        <h1 class="lo-title">{first.title}</h1>
        <div class="lo-hint">scroll to begin ↓</div>
      </div>

      <div class="lo-scene">
        <div class="lo-sticky">
          <div class="lo-art-wrap">
            {loStages.map((s, i) => (
              <figure class="lo-stage" data-stage={i}>
                <div class="lo-art" set:html={ART[i] || ''}></div>
                <figcaption class="lo-cap">
                  <span class="lo-step-no">{i + 1}</span>
                  <h3>{s.name}</h3>
                  <p>{s.info}</p>
                </figcaption>
              </figure>
            ))}
          </div>
          <button class="lo-replay" id="loReplay">↻ Replay</button>
          <div class="lo-dots" id="loDots"></div>
        </div>
        {loStages.map((s, i) => (<div class="lo-step" data-step={i}></div>))}
      </div>

      {(loOrganism || loClosing.length > 0) && (
        <div class="lo-synthesis">
          {loOrganism && <h3>{loOrganism.name}</h3>}
          {loClosing.map((b) => (
            <p>
              {b.segments.map((seg) => (
                seg.term
                  ? <button class="term" data-cat={seg.cat} data-term={seg.term}>{seg.t}</button>
                  : <Fragment>{seg.t}</Fragment>
              ))}
            </p>
          ))}
        </div>
      )}
    </section>
  )}

  <header class="site">
    <div class="kicker">An Interactive Ayurveda Book</div>
    <h1>{content.title}</h1>
    <p class="sub">{content.subtitle}</p>
    <div class="legend">
      {Object.entries(CATS).map(([k, c]) => (
        <span><i class="dot" style={`background:${c.color}`}></i> {c.label}</span>
      ))}
    </div>
  </header>

  <div class="wrap">
    {rest.map((ch) => (
      <section>
        <h2 class="chapter">{ch.kicker}</h2>
        <h3>{ch.title}</h3>
        {ch.blocks.map((b) => (
          b.type === 'level' ? (
            <div class="level">
              <div class="thumb">image<br/>goes here</div>
              <div class="lc"><h4>{b.name}</h4>{b.info && <p>{b.info}</p>}</div>
            </div>
          ) : b.type === 'h' ? (
            <h4 class="subhead">{b.text}</h4>
          ) : b.type === 'list' ? (
            <ul class="bullets">
              {b.items.map((it) => (
                <li>{it.map((s) => (s.term ? <button class="term" data-cat={s.cat} data-term={s.term}>{s.t}</button> : <Fragment>{s.t}</Fragment>))}</li>
              ))}
            </ul>
          ) : (
            <p>{b.segments.map((s) => (s.term ? <button class="term" data-cat={s.cat} data-term={s.term}>{s.t}</button> : <Fragment>{s.t}</Fragment>))}</p>
          )
        ))}
      </section>
    ))}
    <div class="footnote">
      Red = Ayurveda · Amber = Physiology · Olive = Anatomy. Tap any colored word to explore it; close to return to your place.
    </div>
  </div>

  <div class="scrim" id="scrim"></div>
  <aside class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-head">
      <button class="close-x" id="closeX" aria-label="Close and return">×</button>
      <span class="cat-pill" id="catPill">Term</span>
      <h3 id="dTitle">Term</h3>
      <div class="phon" id="dPhon"></div>
    </div>
    <div class="drawer-body" id="dBody"></div>
    <div class="back-hint">← Close to jump back exactly where you were reading.</div>
  </aside>

  <script id="glossary-data" type="application/json" set:html={JSON.stringify(glossary)} />

  <script>
    const CATS = {
      ayurveda:   { label: 'Ayurveda',   color: 'var(--c-ayurveda)' },
      physiology: { label: 'Physiology', color: 'var(--c-physiology)' },
      anatomy:    { label: 'Anatomy',    color: 'var(--c-anatomy)' },
    };
    const GLOSSARY = JSON.parse(document.getElementById('glossary-data').textContent);
    const scrim = document.getElementById('scrim');
    const drawer = document.getElementById('drawer');
    const catPill = document.getElementById('catPill');
    const dTitle = document.getElementById('dTitle');
    const dPhon = document.getElementById('dPhon');
    const dBody = document.getElementById('dBody');
    let savedY = 0;
    function openTerm(key) {
      const g = GLOSSARY[key];
      if (!g) return;
      savedY = window.scrollY;
      const cat = CATS[g.cat] || { label: 'Term', color: 'var(--ink)' };
      catPill.textContent = cat.label; catPill.style.background = cat.color;
      dTitle.textContent = g.title; dTitle.style.color = cat.color;
      dPhon.textContent = g.phon || '';
      dBody.innerHTML = g.body || '<p><em>Definition coming soon.</em></p>';
      scrim.classList.add('open'); drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      history.pushState({ term: key }, '');
    }
    function closeTerm(push) {
      scrim.classList.remove('open'); drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      window.scrollTo({ top: savedY });
      if (push && history.state && history.state.term) history.back();
    }
    document.querySelectorAll('.term').forEach((b) => b.addEventListener('click', () => openTerm(b.dataset.term)));
    document.getElementById('closeX').addEventListener('click', () => closeTerm(true));
    scrim.addEventListener('click', () => closeTerm(true));
    window.addEventListener('popstate', () => closeTerm(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTerm(true); });
  </script>

  <script>
    // Levels-of-Organization scroll scene
    const scene = document.querySelector('.lo-scene');
    if (scene) {
      const stages = [...scene.querySelectorAll('.lo-stage')];
      const steps = [...scene.querySelectorAll('.lo-step')];
      const dotsWrap = document.getElementById('loDots');
      const replay = document.getElementById('loReplay');
      let active = 0;
      const dots = stages.map((_, i) => {
        const d = document.createElement('button');
        d.className = 'lo-dot' + (i === 0 ? ' is-on' : '');
        d.setAttribute('aria-label', 'Go to stage ' + (i + 1));
        d.addEventListener('click', () => steps[i].scrollIntoView({ behavior: 'smooth', block: 'center' }));
        dotsWrap.appendChild(d);
        return d;
      });
      function show(i, force) {
        if (i === active && !force) return;
        if (force) { stages[i].classList.remove('is-active'); void stages[i].offsetWidth; }
        stages.forEach((s, n) => s.classList.toggle('is-active', n === i));
        dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
        // Lottie hook: if a player is dropped into the active stage, play it.
        const player = stages[i].querySelector('[data-lottie]');
        if (player && typeof player.play === 'function') { try { player.stop(); player.play(); } catch (e) {} }
        active = i;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) show(+e.target.dataset.step, false); });
      }, { rootMargin: '-50% 0px -50% 0px' });
      steps.forEach((s) => io.observe(s));
      stages[0].classList.add('is-active');
      replay.addEventListener('click', () => show(active, true));
    }
  </script>
</body>
</html>
